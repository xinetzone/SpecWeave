# Dockerfile.dockerignore for caffe-ffi-jupyter
# Build context: SpecWeave root (context: ../..)
#
# Design: This Dockerfile does NOT COPY any source files from the build context:
#   - Builder: installs via conda + pip (tvm-ffi from PyPI)
#   - Runtime: copies /opt/conda from builder stage; entrypoint is inline heredoc
#   - Source code (caffe-ffi, tvm-ffi) mounted at runtime via volumes
# Excluding large directories to minimize build context transfer.

# Version control internals
.git/

# Large source trees — mounted at runtime, not COPY'd during build
projects/
vendor/
external/
playground/

# Documentation and non-essential assets
docs/
sdk/
docker/
*.md

# Python/agent temp/caches
__pycache__/
*.pyc
.pytest_cache/
.ruff_cache/
.mypy_cache/
.temp/
.trae/
.agents/
node_modules/
.vscode/
.idea/

# OS / misc
.DS_Store
Thumbs.db
*.tar.gz
*.tar.bz2
*.zip
*.whl
*.pt
*.pth
*.pkl
*.npy
*.npz
*.h5
*.hdf5
