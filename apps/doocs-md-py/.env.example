# doocs-md-py 配置示例
# 复制为 .env 后按需填写；全部留空也可启动（本地离线模式：编辑器与渲染可用，云端功能禁用）。
# 与上游 apps/api 同名的环境变量保持一致语义。

# ---- 服务 ----
# 允许的前端来源（逗号分隔；* 仅匹配单个主机标签；扩展协议 origin 自动放行）
APP_URL=http://localhost:8800
# JWT HS256 密钥（生产必须改成随机长字符串；留空时使用仅开发用的固定值并告警）
JWT_SECRET=
# 管理员 GitHub 登录名（逗号分隔，大小写不敏感）
ADMIN_GITHUB_LOGINS=

# ---- GitHub OAuth（留空则登录端点禁用，本地编辑器仍可用）----
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ---- 爱发电（全部留空则 webhook 静默、activate 返回 503）----
AFDIAN_USER_ID=
AFDIAN_API_TOKEN=
AFDIAN_API_BASE=https://afdian.com/api/open
AFDIAN_PRO_PLAN_IDS=
AFDIAN_WEBHOOK_TOKEN=

# ---- 图片上传（/upload）----
UPLOAD_ENABLED=true
# 后端：github | local | s3
UPLOAD_BACKEND=local
UPLOAD_MAX_BYTES=5242880
# GitHub 后端
UPLOAD_GITHUB_USERNAME=bucketio
# 逗号分隔的仓库列表（留空默认 img0..img19）
UPLOAD_GITHUB_REPO_LIST=
UPLOAD_GITHUB_BRANCH=main
UPLOAD_GITHUB_USE_CDN=true
# 逗号分隔的 PAT（UPLOAD_BACKEND=github 时必填）
UPLOAD_GITHUB_TOKENS_BUCKETIO=
# S3 后端 / R2 兼容
UPLOAD_S3_ENDPOINT=
UPLOAD_S3_REGION=auto
UPLOAD_S3_BUCKET=
UPLOAD_S3_ACCESS_KEY_ID=
UPLOAD_S3_SECRET_ACCESS_KEY=
UPLOAD_S3_FORCE_PATH_STYLE=false
UPLOAD_S3_PUBLIC_URL=

# ---- Python 侧新增配置 ----
# SQLite 数据库路径（默认应用数据目录 data/doocs-md-py.db）
DOOCS_MD_PY_SQLITE_PATH=
# 本地上传后端：落盘目录与对外基础 URL
DOOCS_MD_PY_STORAGE_LOCAL_DIR=
DOOCS_MD_PY_STORAGE_LOCAL_BASE_URL=/uploads
# emoji 资产存储前缀（本地后端的子目录或 S3 前缀）
DOOCS_MD_PY_EMOJI_PREFIX=emoji
