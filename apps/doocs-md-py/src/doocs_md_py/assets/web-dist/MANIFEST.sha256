upstream=https://github.com/doocs/md
upstream_commit=1bdad48d20048bddc8d32afb1b75a6475169f163
upstream_worktree_dirty=no
built_at_utc=2026-10-15T07:06:54Z
node=v22.23.3 win-x64（官方 node-v22.23.3-win-x64.zip，SHA256 经 npmmirror 与华为云双镜像交叉校验）
package_manager=pnpm@12.6.0 via corepack（--frozen-lockfile --ignore-scripts）
npm_registry=https://registry.npmmirror.com
build_env=SERVER_ENV=NETLIFY VITE_MD_API_URL=(empty,same-origin) VITE_SYNC_API_URL=(empty)
build_env2=VITE_ACCOUNT_UI_ENABLED=true VITE_SYNC_UI_ENABLED=true VITE_UPLOAD_VIA_API=true
build_note=WSL(openKylin)+podman 路线在本机因 WSL 虚拟机被宿主内存回收（wsl.exe 0xc00000fd）无法完成，改用同版本 node 在 Windows 10 原生构建；构建参数与上游脚本一致
license=WTFPL-2.0（见 LICENSE；版权归 doocs/md 上游贡献者）
