
# Containerfile.client
# ------------------------------------------------------------
# 用途：在 localhost/jupyter-podman-rootless:latest 镜像之上
#       叠加 jupyter-podman-client（镜像消费端）SDK 运行环境。
# 产出：localhost/jupyter-podman-client:latest
#
# 注意（V 阶段对抗审查·经验教训）：
#   1. conda 环境名是 main（不是 py314），且 login shell 才会
#      `conda activate main`；非交互 RUN 阶段 conda env list 看不到
#      main，但 PATH 顶端是 /opt/conda/envs/main/bin，直接用
#      `python -m pip` 就是对的，不要依赖 activate。
#   2. OCI image format 会忽略 SHELL 指令，显式用
#      `/bin/bash -lc '...'` 包裹 RUN 才稳定。
#   3. USER devuser 时 UID 不一定是 1000（基础镜像 1000 已被占用时
#      自动分配，如实际是 1001），COPY --chown 用用户名不硬编码 UID。
#
# 特性（对齐 F 阶段第一性原理设计）：
#   1. 单层叠加（COPY + pip install -e），增量缓存复用率高
#   2. /opt/apps/containers/client/ 为 editable 安装真实目录，
#      保证 _project_root() 向上能命中 pyproject.toml 锚点
#   3. WORKDIR=/workspace，IMAGE_CACHE_DIR 默认 /workspace/.image-cache
#   4. PODMAN_CLIENT_SDK_STRATEGY=legacy（容器内 pure-Linux，
#      直接 PodmanClient.from_env()，跳过 Windows 多候选探测）。
#      R1 修复（2026-09-08·方法论 C3）：容器内 SDK 依赖 bootstrap 前置启动的
#      podman system service（见 env_in_container.py::PODMAN_SERVICE_BOOT），
#      否则 from_env() 会连 /run/user/<UID>/podman/podman.sock 报 FileNotFoundError
#      （被 urllib3 包装成 APIError）。本镜像仅固化 ENV，服务启动由消费端注入。
#   5. 用户仍为 devuser，遵循构建端 non-root 约定
# ------------------------------------------------------------

ARG BASE_IMAGE=localhost/jupyter-podman-rootless:latest
FROM ${BASE_IMAGE}

LABEL org.specweave.component="jupyter-podman-client" \
      org.specweave.layer="podman-py-sdk-runtime" \
      org.specweave.python-version="3.14t" \
      org.specweave.conda-env="main"

# ------------------------------------------------------------
# Layer 1（单层叠加）：拷贝 client 源码并 editable 安装
#   - build context = apps/containers/client/；COPY . 拷贝整个 client 目录
#   - USER root 创建目录 + 改属主 → USER devuser 做 pip install
#   - 不使用 SHELL 指令（OCI 忽略），显式 /bin/bash -lc 包裹
#   - 不 conda activate：PATH 顶端已是 /opt/conda/envs/main/bin
# ------------------------------------------------------------
USER root

ARG APP_SRC_DIR=/opt/apps/containers/client
RUN mkdir -p ${APP_SRC_DIR} \
 && chown -R devuser:devuser /opt

# build context = apps/containers/client/；COPY . 拷贝整个 client 目录内容
COPY --chown=devuser:devuser . ${APP_SRC_DIR}/

USER devuser

# 直接用 PATH 上的 /opt/conda/envs/main/bin/python（无需 conda activate）
# --no-build-isolation 需要预先装好 build backend（scikit-build-core），
# 因为 pyproject.toml 用它；editable 还会把运行时依赖（invoke podman python-dotenv）拉齐。
# 注意：用 set -euo pipefail；invoke --list 必须在 client 根目录（tasks.py 转发层在那）。
# ---- 优化（F 阶段·第一性原理）：单 RUN 结束前清理 ----
#   1. scikit-build-core 的 build-dir（pyproject.toml 为 build/{wheel_tag}）
#      仅 build 阶段用，运行时不需要；rm -rf ${APP_SRC_DIR}/build/
#   2. 历史缓存：~/.cache/pip、conda cache（/opt/conda/pkgs/*.tar.bz2）
#      （--no-cache-dir 其实已不下载 wheel cache，但保留保险）
#   3. *.pyc / __pycache__：字节码编译到 site-packages 之外的源码树内
#      （python3.14t free-threaded 模式下 __pycache__ 命名变，统一 find 清理）
RUN /bin/bash -lc 'set -euo pipefail ; \
    python --version ; \
    python -m pip --version ; \
    python -m pip install --no-cache-dir "scikit-build-core>=0.9" ; \
    python -m pip install --no-cache-dir --no-build-isolation -e /opt/apps/containers/client/ ; \
    python -c "import jpman_client; print(\"jpman_client import OK:\", jpman_client.__file__)" ; \
    cd /opt/apps/containers/client && invoke --list 2>&1 | head -n 40 ; \
    echo "[BUILD-CLEAN] removing build artifacts & caches (single-run optimization)" ; \
    rm -rf /opt/apps/containers/client/build ; \
    find /opt/apps -type d -name "__pycache__" -prune -exec rm -rf {} + ; \
    python -m pip cache purge >/dev/null 2>&1 || true ; \
    rm -rf /home/devuser/.cache/pip ; \
    echo "[BUILD-CLEAN] done"'

# ------------------------------------------------------------
# R2 修复（2026-09-08·方法论 C·根因）：必须在构建期 pip install 之后
# 重置回 root。基础镜像以 root 为主进程（ENTRYPOINT tini->entrypoint.sh ->
# supervisord），由 supervisord 再按 jupyter.conf 将服务降权到 devuser。
# 若保持在 USER devuser，则继承的 entrypoint.sh 以非 root 运行，导致
# setup_passwords 的 chpasswd（pam_chauthtok）、generate_host_keys 的
# ssh-keygen、以及 exec supervisord 全部失败，容器启动即退出（exit 1）。
# USER devuser 仅用于构建期 editable 安装，运行期必须回到 root。
# ------------------------------------------------------------
USER root

# ------------------------------------------------------------
# 运行时默认值（用户可通过 -e 覆盖）
# PYTHONIOENCODING / PYTHONUTF8：容器内 invoke 输出强制 UTF-8，防止被
#   宿主 Windows chcp 936(GBK) 解读时产生中文乱码；同时对齐宿主
#   utils.py::_ensure_win32_console_utf8 的修复策略（两端一致）。
# ------------------------------------------------------------
ENV PODMAN_CLIENT_SDK_STRATEGY=legacy \
    IMAGE_CACHE_DIR=/workspace/.image-cache \
    WORKSPACE=/workspace \
    PYTHONIOENCODING=UTF-8 \
    PYTHONUTF8=1

WORKDIR /workspace

# ------------------------------------------------------------
# 基底指纹（2026-09-11 预防闭环）：env.build-layer 构建时把基底镜像
# ref/digest 经 --build-arg 写入以下 label；invoke run 启动前读取 label
# 并与本地基底当前 digest 比对，不一致即中文警告「叠加层陈旧」并指引重建。
# 根因背景：rootless 基底更新后 tag 移动不会传导给已固化的 overlay
# （2026-09-11 toolbox wrapper 缺席事故即此——client 容器仍跑 5 小时前
# 的旧基底，裸报 Error: TOOLBOX_PATH not set）。LABEL 置于文件末尾，
# 仅新增薄层，不使前置 COPY/RUN 缓存失效。
# ------------------------------------------------------------
ARG BASE_IMAGE
ARG BASE_DIGEST=""
LABEL org.specweave.base-image="${BASE_IMAGE}" \
      org.specweave.base-digest="${BASE_DIGEST}"

# CMD 继承自基础镜像（supervisord + entrypoint.sh），不覆盖。
# 要单独跑客户端命令：
#   podman run --rm localhost/jupyter-podman-client:latest \
#     bash -lc "inv --list"
# login shell 下 bashrc 会自动 `conda activate main`（实际 PATH 已生效）
