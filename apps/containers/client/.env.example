# jupyter-podman-client - 环境变量模板
#
# 优先级：命令行参数 > 本 .env 文件 > ContainerConfig 默认值
# 复制为 .env 后按需修改。所有变量均可省略（fallback 到默认值）。

# 容器名（默认 jupyter-podman）
CONTAINER_NAME=jupyter-podman

# 镜像标签（默认 localhost/jupyter-podman-client:latest，可在其中管理其他镜像）
# 运行其他镜像时：IMAGE_TAG=localhost/other-image:tag
IMAGE_TAG=localhost/jupyter-podman-client:latest

# 端口映射
SSH_PORT=2222
JUPYTER_PORT=8888

# 镜像缓存目录（inv load 自动搜索 *.tar.gz 的目录）
#   优先级：--cache-dir CLI 参数 > 本变量 > 默认：当前执行目录下 .image-cache/
#   相对路径示例（相对 invoke 执行目录）：./.image-cache
#   绝对路径示例（跨项目复用）：D:\images\jpman  或  /mnt/d/images/jpman
IMAGE_CACHE_DIR=./.image-cache

# 工作区路径：
#   Windows 绝对路径例：D:/spaces/SpecWeave   （自动转 /mnt/d/spaces/SpecWeave）
#   WSL/Linux 绝对路径例：/mnt/d/spaces/SpecWeave
#   相对路径例：./workspace  （相对 invoke 执行目录）
WORKSPACE=./workspace

# 登录密码/Jupyter token。留空 = 启动时自动生成并打印。
# 手动设置时：密码至少 8 位，token 建议 32 位字母数字。
USER_PASSWORD=
JUPYTER_TOKEN=

# 注入到容器内 ~devuser/.ssh/authorized_keys 的公钥（可选）
SSH_PUBLIC_KEY=

# 是否给 devuser 开 sudo（默认 yes；opt-out 写 no）
GRANT_SUDO=yes

# ============================================================
# Windows 11 + WSL2 专属（可全省略，默认 auto 自动探测）
# 优先级：shell export > .env > 自动探测 > 回退 CLI fallback
# ============================================================

# SDK 连接策略（auto|legacy|wsl|machine）
#   auto    默认：P0 env→P1 WSL9P→P2 Machine→P3 tcp-loopback 逐级尝试（推荐）
#   legacy  等同于 v0.0.x 旧行为：只走 PodmanClient() 默认 from_env()（Windows 原生大概率挂）
#   wsl     只走 P0/P1 WSL9P socket，跳过 Machine/tcp（确定只连 WSL2 内 daemon）
#   machine 只走 P0/P2 Podman Machine SSH（确定只连 Podman Desktop Machine）
PODMAN_CLIENT_SDK_STRATEGY=auto

# WSL 发行版名（Windows 原生 CPython 连 WSL2 daemon 时，优先 1 级回退）
#   省略 = 按「WSL_DISTRO_NAME env → wsl.exe 默认发行版 → 首个 Running 发行版」3 级探测
#   已知多发行版并存时，显式指定可以避免探测命中预期外的发行版
#   ⚠️ 必须与本机 `wsl.exe --list --quiet` 的实际发行版名一致；写错会导致
#      WSL_E_DISTRO_NOT_FOUND → UID 探测失败 → SDK 候选降级（见 W-I4）。
WSL_DISTRO_NAME=podman-machine-default

# [compose 子进程层·可选] Windows 原生执行 quant.*/xmnn.*/monetize.* 时的
#   透明桥接目标发行版（2026-09-15 起自动桥接优先，门禁兜底）。
#   默认 podman-machine-default（已实证 compose 执行环境：自带 podman 5.7 /
#   podman-compose / /mnt/d 直通 / client editable 安装；该发行版由
#   jupyter-podman-rootless 改名顶替 flapping 的 Podman Desktop machine）。
#   注意：不要把 WSL_DISTRO_NAME（SDK 连接专用）当桥接目标。设为 none
#   显式关闭桥接（回退门禁提示）。
# COMPOSE_WSL_DISTRO=podman-machine-default

# podman daemon 连接 URL（显式覆盖，优先级最高）
# 合法 scheme：unix / http+unix / ssh / http+ssh / tcp / http  ⚠️ podman-py 不支持 npipe://
#   WSL9P（Windows 原生→WSL2 零开销，推荐）：unix:///mnt/wsl/Ubuntu/run/user/1000/podman/podman.sock
#   Podman Machine SSH：ssh://user@127.0.0.1:<Port>（首次连接先跑 podman machine ssh true 写 known_hosts）
#   tcp loopback：tcp://127.0.0.1:8888（需 podman system service 预先手动起）
CONTAINER_HOST=
# DOCKER_HOST=      # 兼容兜底，优先级低于 CONTAINER_HOST

# daemon 宿主运行时 UID（B-scheme：推导 /run/user/<uid>/podman/podman.sock 挂载源，
# 以及 HOST_XDG_RUNTIME_DIR 默认值；见 README §5.4 C-I5）
#   Linux/WSL2 内省略 = 自动取 $XDG_RUNTIME_DIR 末段，再退回 id -u（不要盲目写死 1000）
#   Windows 原生省略 = 1000（WSL2 默认用户惯例，本机 id 无意义）
#   daemon 宿主 UID 与自动推导不一致（如宿主为 1006）时显式指定：
# PODMAN_RUNTIME_UID=1000
# 另：原生 Linux 上若用户级 podman.socket 未运行，invoke run 会自动执行
# `systemctl --user start podman.socket`（无需提权）；重启后失效请 enable-linger。

# ============================================================
# 运行时透传（与构建端 docs/07-toolbx-passthrough.md 的 5 项 opt-in 逐项对应）
# 默认全关 = 默认隔离；命令行 --host-network/--wayland/--gpu/--dbus/--usb 优先，
# 亦可用 --no-<同名开关> 显式关闭此处开启的项（例：PASSTHROUGH_GPU=yes 时 `invoke run --no-gpu`）。
# ⚠️ 资源路径全部在 daemon 宿主（WSL2 / Podman Machine）侧解析，客户端本机看不到；
#    资源缺失时 podman 硬失败（退出码 125、不自动创建），按 C-I3 指引处理（README §5.4）。
# ============================================================
# ① Host 网络模式（不发布端口；SSH=localhost:<SSH_PORT>，Jupyter=localhost:8888）
PASSTHROUGH_HOST_NETWORK=no
# ② Wayland 套接字透传 ⚠️ WSLg：podman machine 的 Wayland socket 在
#    /mnt/wslg/runtime-dir（不是 /run/user/1000），启用时必须把
#    HOST_XDG_RUNTIME_DIR 设为 /mnt/wslg/runtime-dir（见下方路径覆盖段）
PASSTHROUGH_WAYLAND=no
# ③ GPU 透传（需 daemon 宿主存在 GPU_DEVICE；支持两种形态，见下）
PASSTHROUGH_GPU=no
# ④ D-Bus 会话总线透传（需 daemon 宿主存在会话总线）
PASSTHROUGH_DBUS=no
# ⑤ USB 透传 ⚠️ 需先在 Windows 管理员 PowerShell 用 usbipd 绑定并挂载
#    到 WSL 发行版（步骤见下方"USB 透传前提"），否则 podman 硬失败（exit 125）
PASSTHROUGH_USB=no
# ⑥ UVC 摄像头字符设备透传（--video；默认 /dev/video0-3，可用 VIDEO_DEVICES 指定）
PASSTHROUGH_VIDEO=no

# 透传资源路径覆盖（daemon 宿主侧；默认已按 PODMAN_RUNTIME_UID 推导，通常无需修改）
# ⚠️ WSLg Wayland 关键：podman machine 内 Wayland socket 在 /mnt/wslg/runtime-dir，
#    必须显式设成它才能命中（client 拼 {xdg}/{wayland_display}）
# HOST_XDG_RUNTIME_DIR=/mnt/wslg/runtime-dir
# HOST_WAYLAND_DISPLAY=wayland-0
# DBUS_SESSION_BUS_PATH=/run/user/1000/bus
# GPU_DEVICE 两种形态：
#   - 主机设备路径（默认 /dev/dri，Intel/AMD Mesa）：映射到容器内 /dev/dri
#   - CDI 设备引用（NVIDIA，如 nvidia.com/gpu=all）：原样透传，daemon 宿主需先
#     nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml（WSL2 走 /dev/dxg + libcuda）
# GPU_DEVICE=/dev/dri
# GPU_DEVICE=nvidia.com/gpu=all
# USB_DEVICE=/dev/bus/usb
# ⚠️ USB 透传前提（Windows 管理员 PowerShell，usbipd-win 需先安装：
#    winget install --id Dorssel.usbipd-win）：
#   & "C:\Program Files\usbipd-win\usbipd.exe" bind --busid <BUSID>        # 绑定设备（一次）
#   & "C:\Program Files\usbipd-win\usbipd.exe" attach --wsl <发行版> --busid <BUSID>  # 挂载（每次会话）
#   之后 PASSTHROUGH_USB=yes 生效；用毕 usbipd detach --busid <BUSID> 归还 Windows。
#   VM 内确认：ls /dev/bus/usb 应出现 001/002 目录；摄像头采集还需
#   sudo dnf install v4l-utils usbutils（Fedora）后 /dev/video* 可用。
# ⚠️ Video 透传（--video）：透传 /dev/video0-3（默认）字符设备，需先完成上方
#   usbipd attach 使摄像头在宿主出现 /dev/video*；缺失时 podman 硬失败（exit 125）。
#   用 VIDEO_DEVICES 精确指定逗号分隔列表：
# VIDEO_DEVICES=/dev/video0,/dev/video1

# ============================================================
# invoke env.* 自举环境（Containerfile.client 叠加层专用，宿主侧写 .env 不生效，仅供文档）
# 容器内默认值（由 Containerfile.client ENV 注入，可通过 podman run -e 覆盖）：
#   PODMAN_CLIENT_SDK_STRATEGY=legacy   # pure-Linux，直接 from_env()，跳过 Windows 多候选
#   IMAGE_CACHE_DIR=/workspace/.image-cache
#   WORKSPACE=/workspace
#
# 自举镜像标签（默认 localhost/jupyter-podman-client:latest，invoke env.build-layer 产出）：
# JPMAN_CLIENT_IMAGE=localhost/jupyter-podman-client:latest
#
# 自举容器名（默认 jpman-client-env，用完自动 --rm 删除）
# JPMAN_CLIENT_CONTAINER=jpman-client-env
# ============================================================

# ============================================================
# quant.* ONNX 量化工作负载叠加栈（opt-in，podman-compose 子进程层）
# Windows 原生 CPython 不支持本命名空间（门禁）：请在 WSL2 发行版内运行，
# 或 invoke env.run-cmd 进自举容器（基底已内嵌 podman-compose）。
# 优先级：shell export > 本 .env > compose.yaml 内默认；裸 podman-compose
# 用户亦可在 overlays/onnx-quantized/ 复制其 .env.example 为 .env。
# 完整键注释见 overlays/onnx-quantized/.env.example（两处键集合保持一致）
# 下列键默认全部注释：compose.yaml 内置默认值即可工作，需要覆盖时按需取消注释
# ============================================================
# 量化镜像 / 容器 / 端口
# QUANT_IMAGE_TAG=localhost/onnx-quantized:latest
# QUANT_CONTAINER_NAME=onnx-quantized
# QUANT_SSH_PORT=2222
# QUANT_JUPYTER_PORT=8888
# 工作区（留空时任务默认 client/workspace 并自动转绝对 POSIX 路径）
# QUANT_WORKSPACE=../../workspace
# 凭证（留空 = 基底 entrypoint 自动生成并打印）
# USER_PASSWORD=
# JUPYTER_TOKEN=
# SSH_PUBLIC_KEY=
# GRANT_SUDO=yes
# 推理线程 / 构建期 pip 源（official|aliyun|tuna）
# OMP_NUM_THREADS=4
# OPENBLAS_NUM_THREADS=1
# PIP_MIRROR=official
# GPU：不设环境变量，用命令行开关 invoke quant.up --gpu（compose.gpu.yaml 叠加 /dev/dri）

# ============================================================
# xmnn.* XMNN 开发/打包叠加栈（opt-in，podman-compose 子进程层）
# 运行时 bind 挂载 npu_tvm/npuusertools/models 源码，容器内 LLVM 22 +
# Nuitka 4.1.3 工具链，支持源码调试与 xmnn whl 打包。
# Windows 原生 CPython 不支持本命名空间（门禁）：WSL2 发行版内运行，
# 或 invoke env.run-cmd 进自举容器。
# 优先级：shell export > 本 .env > compose.yaml 默认；裸 podman-compose
# 用户亦可在 overlays/xmnn-dev/ 复制其 .env.example 为 .env（键集合一致）。
# 下列键默认全部注释：compose.yaml 内置默认值即可工作，需要覆盖时按需取消注释
# ============================================================
# XMNN_IMAGE_TAG=localhost/xmnn-dev:latest
# XMNN_CONTAINER_NAME=xmnn-dev
# XMNN_SSH_PORT=2223
# XMNN_JUPYTER_PORT=8890
# 工作区（wheel 产物默认落其下 dist/；留空时任务默认 client/workspace 并转 POSIX）
# XMNN_WORKSPACE=../../workspace
# 三个源码挂载（invoke 路径做存在性硬校验；默认仓库根 external/chaos/*）
# NPU_TVM_PATH=/mnt/d/spaces/SpecWeave/external/chaos/npu_tvm
# NPUUSERTOOLS_PATH=/mnt/d/spaces/SpecWeave/external/chaos/npuusertools
# MODELS_PATH=/mnt/d/spaces/SpecWeave/external/chaos/models
# 凭证（留空 = 基底 entrypoint 自动生成并打印）
# USER_PASSWORD=
# JUPYTER_TOKEN=
# SSH_PUBLIC_KEY=
# GRANT_SUDO=yes
# 编译/推理调优
# OMP_NUM_THREADS=4
# NUITKA_JOBS=8
# 构建期镜像源（official|aliyun|tuna）
# PIP_MIRROR=official
# CONDA_MIRROR=official
# 基底镜像（compose build args，通常无需改）
# BASE_IMAGE=localhost/jupyter-podman-rootless:latest

# ============================================================
# monetize.* agent-monetize tvm-ffi 原生编译栈（opt-in，podman-compose 子进程层，
# Windows 原生 CPython 不支持，详见 overlays/agent-monetize-dev/.env.example）
# 下列键默认全部注释；裸 compose 用户复制为 overlay .env，invoke 路径自行解析默认。
# ============================================================
# --- monetize.* 栈（8 任务：build/up/down/ps/logs/smoke/build-native/wheel） ---
# MONETIZE_IMAGE_TAG=localhost/agent-monetize-dev:latest
# MONETIZE_CONTAINER_NAME=agent-monetize-dev
# MONETIZE_SSH_PORT=2224
# MONETIZE_JUPYTER_PORT=8892
# MONETIZE_WORKSPACE=./workspace
# MONETIZE_SRC_PATH=../../apps/agent-monetize
# USER_PASSWORD=
# JUPYTER_TOKEN=
# SSH_PUBLIC_KEY=
# GRANT_SUDO=yes
# PIP_MIRROR=official

# ============================================================
# 基底陈旧检测（invoke run 启动前）
# 叠加镜像固化了构建时刻的 rootless 基底；inv load 更新基底后若不重新
# env.build-layer，容器会继续跑旧基底（run 会打印中文警告，不阻断启动）。
# 确认有意使用旧基底时，置 1 静默该警告：
# JPUMAN_SKIP_BASE_CHECK=1
# ============================================================

