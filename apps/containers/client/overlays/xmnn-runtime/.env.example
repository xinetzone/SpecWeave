# xmnn-runtime 叠加栈环境变量（裸 podman-compose 路径用）
#
# 用法：cp .env.example .env 后按需修改；invoke xmnnrt.* 路径的键集合
# 与本文件一致（优先级：shell 显式 export > 根 client .env > 本文件/
# compose 默认值）。
#
# 前置：wheels/ 下必须已有 xmnn-*.whl（invoke xmnnrt.build 会自动从
# client/workspace/dist 暂存；裸 compose up 前请手工放入或先跑一次
# invoke xmnnrt.build）。

# 镜像 / 容器 / 端口（默认 2225/8893，与 quant 2222/8888、xmnn 2223/8890、
# monetize 2224/8892 错开）
XMNNRT_IMAGE_TAG=localhost/xmnn-runtime:latest
XMNNRT_CONTAINER_NAME=xmnn-runtime
XMNNRT_SSH_PORT=2225
XMNNRT_JUPYTER_PORT=8893

# notebook 工作区 → /workspace（相对路径相对本文件；invoke 注入绝对路径）
XMNNRT_WORKSPACE=../../workspace

# 基底镜像（与 xmnn-dev 构建器共享同一 rootless 基底以保证 ABI 一致）
BASE_IMAGE=localhost/jupyter-podman-rootless:latest

# 构建期 pip 源：official|aliyun|tuna（wheel 的 19 个运行时依赖解析用）
PIP_MIRROR=official

# 凭证四变量（留空 = 基底 entrypoint 启动时自动生成并打印）
USER_PASSWORD=
JUPYTER_TOKEN=
SSH_PUBLIC_KEY=
GRANT_SUDO=yes
