# agent-monetize-dev 叠加栈 - compose 插值变量模板
#
# 由 client-overlay-scaffold 骨架生成。替换 __X__ 占位符后使用。
#
# 两处事实源（键集合必须与 compose.yaml 的 ${...} 逐一对应）：
#   ① invoke monetize.*（推荐）：在 apps/containers/client/.env 写同名键，
#      任务以 load_dotenv(override=False) 注入——shell export > root .env
#      > compose 默认；invoke 会把宿主路径解析为绝对 POSIX 并做存在性校验。
#   ② 裸 podman-compose：在本目录复制为 .env（自动读取）。
#
# Windows 原生 CPython 门禁：WSL2 发行版内运行，或
#   invoke env.run-cmd --cmd 'inv monetize.up'（自举容器内执行）。

# 镜像标签 / 容器名（compose project name 固定为 agent-monetize-dev）
MONETIZE_IMAGE_TAG=localhost/agent-monetize-dev:latest
MONETIZE_CONTAINER_NAME=agent-monetize-dev

# 端口映射（与已运行栈错开；client 现有：quant 2222/8888、native 2223/8890）
MONETIZE_SSH_PORT=2224
MONETIZE_JUPYTER_PORT=8892

# 通用工作区（绑定容器 /workspace）
MONETIZE_WORKSPACE=../../workspace

# agent-monetize 源码宿主路径。
# 裸 podman-compose：相对路径锚定本文件所在 overlay 目录（上 4 级到 apps/）。
# invoke 路径：本文件不被 invoke 读取（invoke 读 client/.env）；invoke 默认值
# 锚定仓库根 apps/agent-monetize（root.parents[2]），可用绝对路径覆盖。
MONETIZE_SRC_PATH=../../../../agent-monetize

# 凭证（留空 = 基底 entrypoint 自动生成并打印）
USER_PASSWORD=
JUPYTER_TOKEN=
SSH_PUBLIC_KEY=
GRANT_SUDO=yes

# B-scheme 宿主 rootless podman socket（容器内 Notebook/CLI 的
# PodmanClient 经它复用宿主 daemon；invoke 路径自动预检/自愈并注入实际
# 路径，通常无需取消注释）：
#   - 默认 /run/user/1000/... 是 WSL2 惯例 UID；物理 Linux 按 `id -u`
#     改 HOST_PODMAN_SOCK，或只设 PODMAN_RUNTIME_UID（invoke 路径据此推导，
#     裸 compose 不读此键）。
#   - 宿主 socket 丢失：systemctl --user start podman.socket（invoke up
#     会免提权自动执行一次）；重启后仍丢失：sudo loginctl enable-linger "$USER"。
#   - 裸 podman-compose（无 invoke）必须显式给对；路径错误时 compose 因
#     create_host_path:false 硬失败——这是有意保护，避免回退到不可用的
#     容器内自建 daemon（嵌套 rootless 下 newuidmap 被拒）。
# HOST_PODMAN_SOCK=/run/user/1000/podman/podman.sock
# PODMAN_RUNTIME_UID=1000

# 构建期 pip 镜像源（official|aliyun|tuna）。**无前缀构建参数单一事实源
# （C15）**：inv monetize.build、inv monetize.up 的内联 build、compose 段
# 三处同键读取；命令行 --pip-mirror 只覆盖单次 build（up/compose 看不到旗标）
PIP_MIRROR=official
# 基底镜像（compose build args，通常无需改）
# BASE_IMAGE=localhost/jupyter-podman-rootless:latest
