# agent-monetize-dev 叠加栈 - compose 插值变量模板
#
# 由 client-overlay-scaffold 骨架生成。替换 __X__ 占位符后使用。
#
# 两处事实源（键集合必须与 compose.yaml 的 ${...} 逐一对应）：
#   ① invoke monetize.*（推荐）：在 apps/containers/client/.env 写同名键，
#      任务以 load_dotenv(override=False) 注入——shell export > root .env
#      > compose 默认；invoke 会把宿主路径解析为绝对 POSIX 并做存在性校验。
#   ② 裸 podman-compose：在本目录复制为 .env（自动读取）。
#
# Windows 原生 CPython 门禁：WSL2 发行版内运行，或
#   invoke env.run-cmd --cmd 'inv monetize.up'（自举容器内执行）。

# 镜像标签 / 容器名（compose project name 固定为 agent-monetize-dev）
MONETIZE_IMAGE_TAG=localhost/agent-monetize-dev:latest
MONETIZE_CONTAINER_NAME=agent-monetize-dev

# 端口映射（与已运行栈错开；client 现有：quant 2222/8888、xmnn 2223/8890）
MONETIZE_SSH_PORT=2224
MONETIZE_JUPYTER_PORT=8892

# 通用工作区（绑定容器 /workspace）
MONETIZE_WORKSPACE=../../workspace

# agent-monetize 源码宿主路径（invoke 做存在性硬校验）。
# 裸 compose 相对路径相对本文件（上 4 级到 apps/）；invoke 路径以绝对
# POSIX 注入，默认 client 根上两级 apps/agent-monetize。
MONETIZE_SRC_PATH=../../../../agent-monetize

# 凭证（留空 = 基底 entrypoint 自动生成并打印）
USER_PASSWORD=
JUPYTER_TOKEN=
SSH_PUBLIC_KEY=
GRANT_SUDO=yes

# 构建期 pip 镜像源（official|aliyun|tuna）。独立 inv monetize.build 只认
# 命令行 --pip-mirror；此处的值在 inv monetize.up 的 compose 内联 build
# 与裸 podman-compose build 时插值生效
PIP_MIRROR=official
# 基底镜像（compose build args，通常无需改）
# BASE_IMAGE=localhost/jupyter-podman-rootless:latest
