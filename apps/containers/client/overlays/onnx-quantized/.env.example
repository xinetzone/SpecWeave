# onnx-quantized 叠加栈 - compose 插值变量模板
#
# 两种用法对应两处事实源：
#   ① invoke quant.*（推荐）：在 apps/containers/client/.env 写同名 QUANT_* 变量，
#      任务以 load_dotenv(override=False) 注入子进程——shell 显式 export 优先级最高，
#      root .env 次之，本文件的默认值最后（compose.yaml ${VAR:-default}）。
#   ② 裸 podman-compose：在本目录复制为 .env（podman-compose 自动读取）。
#
# 复制为 .env 后按需修改；所有变量均可省略（回退到 compose.yaml 内默认值）。

# 量化镜像标签（inv quant.build / compose build 的产出）
QUANT_IMAGE_TAG=localhost/onnx-quantized:latest

# 容器/栈名（podman-compose project name 固定为 onnx-quantized，此处仅容器名）
QUANT_CONTAINER_NAME=onnx-quantized

# 端口映射（宿主:容器内）
QUANT_SSH_PORT=2222
QUANT_JUPYTER_PORT=8888

# 工作区宿主路径（绑定到容器内 /workspace）
#   invoke 路径下：留空时任务默认解析为 client/workspace 绝对路径并自动转 POSIX
#   裸 compose 路径下：相对路径相对本 compose.yaml（../../workspace = client/workspace）
# Windows 例：D:/spaces/SpecWeave（经 WSL daemon 时任务侧自动转 /mnt/d/...）
QUANT_WORKSPACE=../../workspace

# 登录密码 / Jupyter token；留空 = 由基底 entrypoint 启动时自动生成并打印
USER_PASSWORD=
JUPYTER_TOKEN=

# 注入容器内 ~devuser/.ssh/authorized_keys 的公钥（可选，留空不注入）
SSH_PUBLIC_KEY=

# 是否给 devuser 开 NOPASSWD sudo（基底默认 yes；rootless 开发容器惯例）
GRANT_SUDO=yes

# B-scheme 宿主 rootless podman socket（容器内 Notebook/CLI 的
# PodmanClient 经它复用宿主 daemon；invoke 路径自动预检/自愈并注入实际
# 路径，通常无需取消注释）：
#   - 默认 /run/user/1000/... 是 WSL2 惯例 UID；物理 Linux 按 `id -u`
#     改 HOST_PODMAN_SOCK，或只设 PODMAN_RUNTIME_UID（invoke 路径据此推导，
#     裸 compose 不读此键）。
#   - 宿主 socket 丢失：systemctl --user start podman.socket（invoke up
#     会免提权自动执行一次）；重启后仍丢失：sudo loginctl enable-linger "$USER"。
#   - 裸 podman-compose（无 invoke）必须显式给对；路径错误时 compose 因
#     create_host_path:false 硬失败——这是有意保护，避免回退到不可用的
#     容器内自建 daemon（嵌套 rootless 下 newuidmap 被拒）。
# HOST_PODMAN_SOCK=/run/user/1000/podman/podman.sock
# PODMAN_RUNTIME_UID=1000

# 量化推理线程调优（Containerfile 已固化默认值，此处可运行时覆盖）
OMP_NUM_THREADS=4
OPENBLAS_NUM_THREADS=1

# 构建期 pip 镜像源（official|aliyun|tuna），仅 inv quant.build / compose build 使用
PIP_MIRROR=official

# GPU 透传（默认关：不带 --gpu 时 up 不加载任何 GPU 覆盖文件，设备零透传）
#   invoke 路径：`invoke quant.up --gpu`，设备由 GPU_DEVICE 决定（未设时自动探测
#     /dev/dri → /dev/dxg 并自动选覆盖文件，C19）
#   裸 compose 路径：自行二选一（两者互斥，不可同时加载）
#     podman-compose -f compose.yaml -f compose.gpu.yaml      up -d   # PCI 设备 / CDI
#     podman-compose -f compose.yaml -f compose.gpu.wsl.yaml  up -d   # WSL2：/dev/dxg + libcuda
#   GPU_DEVICE 形态：以 / 开头=宿主机设备路径（/dev/dri、/dev/dxg）；
#     其他=CDI 引用，如 nvidia.com/gpu=all（宿主先
#     `nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml`）
# GPU_DEVICE=/dev/dri
