# onnx-quantized 叠加栈 - compose 插值变量模板
#
# 两种用法对应两处事实源：
#   ① invoke quant.*（推荐）：在 apps/containers/client/.env 写同名 QUANT_* 变量，
#      任务以 load_dotenv(override=False) 注入子进程——shell 显式 export 优先级最高，
#      root .env 次之，本文件的默认值最后（compose.yaml ${VAR:-default}）。
#   ② 裸 podman-compose：在本目录复制为 .env（podman-compose 自动读取）。
#
# 复制为 .env 后按需修改；所有变量均可省略（回退到 compose.yaml 内默认值）。

# 量化镜像标签（inv quant.build / compose build 的产出）
QUANT_IMAGE_TAG=localhost/onnx-quantized:latest

# 容器/栈名（podman-compose project name 固定为 onnx-quantized，此处仅容器名）
QUANT_CONTAINER_NAME=onnx-quantized

# 端口映射（宿主:容器内）
QUANT_SSH_PORT=2222
QUANT_JUPYTER_PORT=8888

# 工作区宿主路径（绑定到容器内 /workspace）
#   invoke 路径下：留空时任务默认解析为 client/workspace 绝对路径并自动转 POSIX
#   裸 compose 路径下：相对路径相对本 compose.yaml（../../workspace = client/workspace）
# Windows 例：D:/spaces/SpecWeave（经 WSL daemon 时任务侧自动转 /mnt/d/...）
QUANT_WORKSPACE=../../workspace

# 登录密码 / Jupyter token；留空 = 由基底 entrypoint 启动时自动生成并打印
USER_PASSWORD=
JUPYTER_TOKEN=

# 注入容器内 ~devuser/.ssh/authorized_keys 的公钥（可选，留空不注入）
SSH_PUBLIC_KEY=

# 是否给 devuser 开 NOPASSWD sudo（基底默认 yes；rootless 开发容器惯例）
GRANT_SUDO=yes

# 量化推理线程调优（Containerfile 已固化默认值，此处可运行时覆盖）
OMP_NUM_THREADS=4
OPENBLAS_NUM_THREADS=1

# 构建期 pip 镜像源（official|aliyun|tuna），仅 inv quant.build / compose build 使用
PIP_MIRROR=official
