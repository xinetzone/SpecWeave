# xmnn-dev 叠加栈 - compose 插值变量模板
#
# 两种用法对应两处事实源：
#   ① invoke xmnn.*（推荐）：在 apps/containers/client/.env 写同名 XMNN_*/
#      NPU_TVM_PATH 等变量，任务以 load_dotenv(override=False) 注入子进程——
#      shell 显式 export 优先级最高，root .env 次之，本文件默认值最后。
#      invoke 会把四个宿主路径解析为绝对 POSIX 路径并做存在性硬校验。
#   ② 裸 podman-compose：在本目录复制为 .env（podman-compose 自动读取）。
#
# 复制为 .env 后按需修改；所有变量均可省略（回退 compose.yaml 默认值）。
# Windows 原生 CPython 门禁：请在 WSL2 发行版内运行，或
#   invoke env.run-cmd --cmd 'inv xmnn.up'（自举容器内执行）。

# 叠加镜像标签 / 容器名（compose project name 固定为 xmnn-dev）
XMNN_IMAGE_TAG=localhost/xmnn-dev:latest
XMNN_CONTAINER_NAME=xmnn-dev

# 端口映射（默认 2223/8890，与 onnx 栈 2222/8888 错开，支持并行运行）
XMNN_SSH_PORT=2223
XMNN_JUPYTER_PORT=8890

# 通用工作区（绑定到容器内 /workspace，wheel 产物默认落其下 dist/）
#   invoke 路径留空时默认 client/workspace 绝对路径并自动转 POSIX
#   裸 compose 相对路径相对本文件：../../workspace = client/workspace
XMNN_WORKSPACE=../../workspace

# 源码挂载（invoke 路径会做存在性校验；裸 compose 相对路径相对本文件，
# 五级 ../../../../../ 回到仓库根）
# 9p 性能提示：TVM 全量编译在 Windows 挂载盘上较慢，可把变量指向 WSL
# 原生克隆，如 /root/build/npu_tvm（见 overlay README §性能）。
NPU_TVM_PATH=../../../../../external/chaos/npu_tvm
NPUUSERTOOLS_PATH=../../../../../external/chaos/npuusertools
MODELS_PATH=../../../../../external/chaos/models

# 登录密码 / Jupyter token；留空 = 基底 entrypoint 自动生成并打印
USER_PASSWORD=
JUPYTER_TOKEN=

# 注入容器内 ~devuser/.ssh/authorized_keys 的公钥（可选）
SSH_PUBLIC_KEY=

# 是否给 devuser 开 NOPASSWD sudo（基底默认 yes）
GRANT_SUDO=yes

# 运行时调优（compose 注入；build-wheel.sh 另读 NUITKA_JOBS）
OMP_NUM_THREADS=4
NUITKA_JOBS=8

# 构建期镜像源（official|aliyun|tuna）：独立 inv xmnn.build 用命令行参数
# --pip-mirror/--conda-mirror；此处的值在 inv xmnn.up 的 compose 内联 build
# 与裸 podman-compose build 时插值生效
PIP_MIRROR=official
CONDA_MIRROR=official
# 基底镜像（compose build args；默认值已在 compose.yaml，通常无需改）
# BASE_IMAGE=localhost/jupyter-podman-rootless:latest
