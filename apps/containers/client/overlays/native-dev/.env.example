# native-dev 叠加栈 - compose 插值变量模板
#
# 两种用法对应两处事实源：
#   ① invoke native.*（推荐）：在 apps/containers/client/.env 写同名 NATIVE_*/
#      NPU_TVM_PATH 等变量，任务以 load_dotenv(override=False) 注入子进程——
#      shell 显式 export 优先级最高，root .env 次之，本文件默认值最后。
#      invoke 会把五个宿主路径解析为绝对 POSIX 路径并做校验（源码三类存在性
#      硬校验；临时目录缺失幂等 mkdir）。
#   ② 裸 podman-compose：在本目录复制为 .env（podman-compose 自动读取）。
#
# 复制为 .env 后按需修改；所有变量均可省略（回退 compose.yaml 默认值）。
# Windows 原生 CPython 门禁：请在 WSL2 发行版内运行，或
#   invoke env.run-cmd --cmd 'inv native.up'（自举容器内执行）。

# 叠加镜像标签 / 容器名（compose project name 固定为 native-dev）
NATIVE_IMAGE_TAG=localhost/native-dev:latest
NATIVE_CONTAINER_NAME=native-dev

# 端口映射（默认 2223/8890，与 onnx 栈 2222/8888 错开，支持并行运行）
NATIVE_SSH_PORT=2223
NATIVE_JUPYTER_PORT=8890

# 通用工作区（绑定到容器内 /workspace，wheel 产物默认落其下 dist/）
#   invoke 路径留空时默认 client/workspace 绝对路径并自动转 POSIX
#   裸 compose 相对路径相对本文件：../../workspace = client/workspace
NATIVE_WORKSPACE=../../workspace

# 源码挂载变体（可改绑或剥离；invoke 路径会做存在性校验；裸 compose
# 相对路径相对本文件，五级 ../../../../../ 回到仓库根）
# 9p 性能提示：TVM 全量编译在 Windows 挂载盘上较慢，可把变量指向 WSL
# 原生克隆，如 /root/build/npu_tvm（见 overlay README §性能）。
NPU_TVM_PATH=../../../../../external/chaos/npu_tvm
NPUUSERTOOLS_PATH=../../../../../external/containers/workspace/dev/npuusertools
MODELS_PATH=../../../../../external/chaos/models

# 临时目录（挂容器内 /workspace/temp）：宿主根工作区 .temp（根 AGENTS.md 定义的
# 统一临时目录），存放编译/调试临时产物，不混入 client/workspace。
#   留空/未设 → invoke 取「仓库根上溯四级」/.temp，裸 compose 取本文件上溯九级
#   /.temp（两者在本仓布局下同指 /media/pc/data/ai/.temp）。
#   与源码三类不同，本目录**缺失不报错**（幂等 mkdir，缺失属正常首态）；
#   缺省值按本仓布局推导，换检出位置请显式指绝对路径，否则会在锚点外建同名目录。
#   ⚠️ 上溯层数越出文件系统根时（如浅布局检出），invoke 侧 fail-fast（Exit(1) +
#      指引设本变量为布局无关的绝对路径），不会真的去建 /.temp（越界解析守卫，
#      2026-09-23 起 overlay_core._resolve_path 生效，测试见 test_overlay_core.py）。
# ⚠️ 该 bind 覆盖 /workspace 下的同名子目录：容器内 /workspace/temp 从此不再是
#    宿主 client/workspace/temp（后者在容器内不可见；宿主侧文件不受影响）。
NATIVE_TEMP_PATH=../../../../../../../../../.temp

# 登录密码 / Jupyter token；留空 = 基底 entrypoint 自动生成并打印
USER_PASSWORD=
JUPYTER_TOKEN=

# 注入容器内 ~devuser/.ssh/authorized_keys 的公钥（可选）
SSH_PUBLIC_KEY=

# 是否给 devuser 开 NOPASSWD sudo（基底默认 yes）
GRANT_SUDO=yes

# B-scheme 宿主 rootless podman socket（容器内 Notebook/CLI 的
# PodmanClient 经它复用宿主 daemon；invoke 路径自动预检/自愈并注入实际
# 路径，通常无需取消注释）：
#   - 默认 /run/user/1000/... 是 WSL2 惯例 UID；物理 Linux 按 `id -u`
#     改 HOST_PODMAN_SOCK，或只设 PODMAN_RUNTIME_UID（invoke 路径据此推导，
#     裸 compose 不读此键）。
#   - 宿主 socket 丢失：systemctl --user start podman.socket（invoke up
#     会免提权自动执行一次）；重启后仍丢失：sudo loginctl enable-linger "$USER"。
#   - 裸 podman-compose（无 invoke）必须显式给对；路径错误时 compose 因
#     create_host_path:false 硬失败——这是有意保护，避免回退到不可用的
#     容器内自建 daemon（嵌套 rootless 下 newuidmap 被拒）。
# HOST_PODMAN_SOCK=/run/user/1000/podman/podman.sock
# PODMAN_RUNTIME_UID=1000

# 运行时调优（compose 注入；build-wheel.sh 另读 NUITKA_JOBS）
OMP_NUM_THREADS=4
NUITKA_JOBS=8

# GPU 透传（默认关：不带 --gpu 时 up 不加载任何 GPU 覆盖文件，设备零透传）。
#   ① 以 / 开头 → 宿主机设备路径，如 /dev/dri、/dev/dxg
#   ② 其他 → CDI 引用，如 nvidia.com/gpu=all（宿主先
#      `sudo nvidia-ctk cdi generate --output=/etc/cdi/nvidia.yaml`）
#   ③ **留空/未设 → 运行期自动探测**（C19）：NVIDIA CDI（/etc/cdi 或 /var/run/cdi
#      下有规格 且 /dev/nvidiactl 存在）→ /dev/dri → /dev/dxg，取首个命中。
#      纯 N 卡宿主加载 nvidia_drm 后同样注册 /dev/dri，故 CDI 必须前置于 /dev/dri，
#      否则只会挂 DRM 节点、容器内没有 libcuda（torch.cuda 恒 False）。
#      选中 NVIDIA 路径（显式或自动）时先跑宿主 nvidia-smi 健康预检：驱动内核模块
#      与用户态库版本失配（报 "Driver/library version mismatch"，常见于驱动升级
#      后未重启）立即 fail-fast 并打印重启/CDI 重建指引，不把损坏设备挂进容器。
#      WSL2 形态（/dev/dxg）自动改用 compose.gpu.wsl.yaml（额外三条 ro 挂载）。
#   与根 `invoke run --gpu` 同键同语义；开关本身是 `invoke native.up --gpu`。
# GPU_DEVICE=/dev/dri

# 透传覆盖（默认全关；与 GPU 正交，都是运行期维度，镜像内容相同零额外构建）：
#   inv native.up --passthrough            主层：host 网络 + D-Bus
#   inv native.up --passthrough --usb      主层 + USB
#   inv native.up --usb                    bridge 网络 + USB
#   inv native.up --gui                    GUI（bridge 即可用，无需 --passthrough）
# host 形态端口变 8888/2223（Jupyter 固定 8888、SSH 经 HOST_NET_SSHD_PORT），
#   8888/SSH 端口被占或 D-Bus/USB/GUI 资源缺失即 fail-fast 中文指引。
# NATIVE_PASSTHROUGH_IMAGE_TAG=localhost/native-dev:passthrough
# DBUS_SESSION_BUS_PATH=/run/user/1000/bus
# HOST_NET_SSHD_PORT=2223
# USB_DEVICE=/dev/bus/usb
# GUI（C33）：WSL2/Win11 零配置（内核自动探测 /mnt/wslg 双通道）；仅物理 Linux
#   或非标准 WSLg 路径需要改指。X11 另需宿主 xhost local:root 放行。
# HOST_XDG_RUNTIME_DIR=/mnt/wslg/runtime-dir
# HOST_WAYLAND_DISPLAY=wayland-0
# GUI_X11_SOCKETDIR=/mnt/wslg/.X11-unix
# GUI_DISPLAY=:0

# 构建期镜像源（official|aliyun|tuna）：**无前缀构建参数单一事实源（C15）**，
# 同时被 inv native.build、inv native.up 的内联 build、compose 段读取；命令行
# --pip-mirror/--conda-mirror 只覆盖单次 build（up/compose 看不到旗标）
PIP_MIRROR=official
CONDA_MIRROR=official
# torch 形态（空|cpu|cu130）：**同为 C15 无前缀键**，默认空 = 镜像不含 torch。
#   空    → 不装（默认镜像体积与离线契约不变）
#   cpu   → download.pytorch.org/whl/cpu 装 torch 2.14.0
#   cu130 → download.pytorch.org/whl/cu130 装 CUDA 13.0 版 torch 2.14.0
#   命令行等价：inv native.build --torch cu130（只覆盖单次 build）
#   改此键后必须重建镜像：inv native.build && inv native.up
TORCH_FLAVOR=
# 离线模式总开关（0 关 / 1 开；默认关）
#   ⚠️ 非 compose 插值键：compose environment 段不引用它（保持黄金快照不变）。
#   ① invoke 路径：本文件（client/.env）里的值由任务读取，up 时强制跳过构建
#      （--no-build 恒真，离线与在线同构，C16）并给容器内打包脚本注入
#      -e NATIVE_OFFLINE=1；亦可直接 `invoke native.up --offline`。
#   ② 裸 compose：up 阶段自行加 --no-build；进容器跑打包脚本时显式
#      `podman-compose exec -e NATIVE_OFFLINE=1 native bash /opt/native-builder/scripts/build-wheel.sh`
# NATIVE_OFFLINE=1
# 基底镜像（compose build args；默认值已在 compose.yaml，通常无需改）
# BASE_IMAGE=localhost/jupyter-podman-rootless:latest
