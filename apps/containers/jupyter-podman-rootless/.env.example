# Jupyter Podman Rootless - Environment Configuration
# Copy this file to .env and modify as needed
# cp .env.example .env

# ── Container Configuration ──────────────────────────────────────────────
CONTAINER_NAME=jupyter-podman
IMAGE_TAG=jupyter-podman-rootless:latest

# ── Port Mapping ─────────────────────────────────────────────────────────
SSH_PORT=2222
JUPYTER_PORT=8888

# ── Workspace Mount ──────────────────────────────────────────────────────
# WSL2/Windows paths will be auto-converted by both `invoke run` and `jpman start`
# Supports both short name (WORKSPACE) and JUPYTER_* prefix (JUPYTER_WORKSPACE)
# CLI override: jpman start -w /path/to/workspace
WORKSPACE=./workspace

# ── Authentication ───────────────────────────────────────────────────────
# Leave empty for auto-generation (invoke run will generate random values)
USER_PASSWORD=
JUPYTER_TOKEN=
# SSH_PUBLIC_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5... your-key"

# ── Permissions ──────────────────────────────────────────────────────────
# Set to "yes" to grant devuser passwordless sudo
GRANT_SUDO=no

# ── Build-time Mirror Configuration ──────────────────────────────────────
# Choices: official | tuna | aliyun
APT_MIRROR=official
CONDA_MIRROR=official
PIP_MIRROR=official

# ── ML Model Registry (OMLMD) ──────────────────────────────────────────
# Local registry: start with `podman-compose --profile registry up -d`
# Access from jupyter container: http://model-registry:5000
# Remote registry example: ghcr.io, docker.io/username
REGISTRY_URL=localhost:5000
REGISTRY_PORT=5000
REGISTRY_PLAIN_HTTP=true

# ── Dev Pass-through (Toolbx-style "透传优于隔离") ──────────────────────
# Enable dev tools pass-through: SSH agent, git config, GUI apps, pip cache
# Usage: podman-compose -f compose.yaml -f compose.dev.yaml up -d
# Or set COMPOSE_FILE in your shell: export COMPOSE_FILE=compose.yaml:compose.dev.yaml
#
# SSH agent socket (auto-detected on Linux, set manually if needed):
# SSH_AUTH_SOCK=/run/user/1000/keyring/ssh
#
# Host network mode: set to "1" to use --net=host (no port mapping needed):
# HOST_NETWORK=0
#
# GPU passthrough: mount /dev/dri for Intel/AMD Mesa GPU:
# GPU_DRI=0
#
# /run/host escape hatch: mount entire host filesystem at /run/host:
# RUN_HOST=0

# ── Runtime Pass-through Overlays (compose.passthrough*.yaml) ───────────
# Layered opt-in overlays for the 5 runtime pass-throughs documented in
# docs/07-toolbx-passthrough.md. Stack ONLY the layers whose host resource exists:
# podman FAILS HARD (exit 125) on a missing mount source / device node and does NOT
# create it. Each overlay file lists its own prerequisite check command in its header.
#
#   podman-compose -f compose.yaml -f compose.passthrough.yaml up -d
#
# [1] Host network + [4] D-Bus  ->  compose.passthrough.yaml
# Dedicated artifact tag for the pass-through stack (keeps :latest for the isolated stack):
# PASSTHROUGH_IMAGE_TAG=jupyter-podman-rootless:passthrough
# D-Bus session bus socket on the host:
# DBUS_SESSION_BUS_PATH=/run/user/1000/bus
#
# [2] Wayland socket            ->  compose.passthrough.gui.yaml
# HOST_XDG_RUNTIME_DIR=/run/user/1000
# HOST_WAYLAND_DISPLAY=wayland-0
#
# [3] GPU                       ->  compose.passthrough.gpu.yaml   (path must exist)
# GPU_DEVICE=/dev/dri
#
# [5] USB                       ->  compose.passthrough.usb.yaml   (path must exist)
# USB_DEVICE=/dev/bus/usb
