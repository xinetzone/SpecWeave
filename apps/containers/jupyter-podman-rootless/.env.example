# Jupyter Podman Rootless - Environment Configuration
# Copy this file to .env and modify as needed
# cp .env.example .env

# ── Container Configuration ──────────────────────────────────────────────
CONTAINER_NAME=jupyter-podman
IMAGE_TAG=jupyter-podman-rootless:latest

# ── Port Mapping ─────────────────────────────────────────────────────────
SSH_PORT=2222
JUPYTER_PORT=8888

# ── Workspace Mount ──────────────────────────────────────────────────────
# WSL2/Windows paths will be auto-converted by `invoke run`
WORKSPACE=./workspace

# ── Authentication ───────────────────────────────────────────────────────
# Leave empty for auto-generation (invoke run will generate random values)
USER_PASSWORD=
JUPYTER_TOKEN=
# SSH_PUBLIC_KEY="ssh-ed25519 AAAAC3NzaC1lZDI1NTE5... your-key"

# ── Permissions ──────────────────────────────────────────────────────────
# Set to "yes" to grant devuser passwordless sudo
GRANT_SUDO=no

# ── Build-time Mirror Configuration ──────────────────────────────────────
# Choices: official | tuna | aliyun
APT_MIRROR=official
CONDA_MIRROR=official
PIP_MIRROR=official
