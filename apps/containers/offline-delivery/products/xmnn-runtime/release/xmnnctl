#!/usr/bin/env bash
# ==============================================================================
# xmnnctl — XMNN Runtime 客户控制脚本（Linux / macOS / WSL，bash 4+）
#
# 用法: ./xmnnctl [--runtime podman|docker|auto] <命令>
#   --runtime/-r  选择容器运行时（可放在命令前或后；默认 auto：先探测
#                 podman 再 docker；命令行优先级高于环境变量 XMNN_RUNTIME）
#   init     创建 .env 并自动生成登录密码与 Jupyter token
#   load     导入底座镜像 + 把 payload/ 内载荷派生装入底座（均幂等；
#            派生构建内已含 10 项守卫，失败即不产出镜像）
#   up       启动服务（先预检宿主端口占用，跨运行时冲突 fail-fast；
#            缺 .env 时自动 init），就绪后打印访问信息
#   down     停止并删除容器（workspace 与 SSH host key 卷保留）
#   ps       查看服务状态
#   logs     查看服务日志（Ctrl+C 退出，不影响容器运行）
#   smoke    运行 10 项运行时守卫（随时复核派生镜像）
#   version  显示交付版本、底座与载荷摘要
# 环境变量: XMNN_RUNTIME=podman|docker|auto 选择容器运行时（被 --runtime 覆盖）
# ==============================================================================
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
cd "$SCRIPT_DIR"

RT=""                 # podman | docker
COMPOSE=()            # compose 命令数组
FILES=()              # -f 文件数组
RUN_FLAGS=()          # rootless run 三必需（docker 下为空）
CLI_RUNTIME=""        # 命令行 --runtime 选择（podman|docker|auto）；空=未提供
REMAIN=()             # 剥离全局参数后剩余的命令与命令参数

c_info() { printf '\033[1;34m[xmnn]\033[0m %s\n' "$*"; }
c_ok()   { printf '\033[1;32m[ OK ]\033[0m %s\n' "$*"; }
c_warn() { printf '\033[1;33m[WARN]\033[0m %s\n' "$*"; }
c_err()  { printf '\033[1;31m[ERR ]\033[0m %s\n' "$*" >&2; }
die()    { c_err "$*"; exit 1; }

usage() {
    sed -n '3,18p' "$0"
}

# ── 运行时与 compose 探测 ────────────────────────────────────────────────────

# 扫描全局参数：--runtime/-r（支持 --runtime=x、-rx 粘连）可出现在命令前后，
# 其余 token 原样保留到 REMAIN（如 init 的 --force）；-- 之后全部按位置参数处理。
# 结果写全局 CLI_RUNTIME / REMAIN；本函数只解析不校验，合法性由 detect_runtime 判。
parse_global_args() {
    CLI_RUNTIME=""
    REMAIN=()
    while [ "$#" -gt 0 ]; do
        case "$1" in
            --runtime|-r)
                [ "$#" -ge 2 ] || die "$1 需要参数：podman|docker|auto"
                CLI_RUNTIME="$2"; shift 2 ;;
            --runtime=*)
                CLI_RUNTIME="${1#--runtime=}"; shift ;;
            -r?*)
                CLI_RUNTIME="${1#-r}"; shift ;;
            --)
                shift; REMAIN+=("$@"); break ;;
            *)
                REMAIN+=("$1"); shift ;;
        esac
    done
}

# 用户级 compose 可执行文件的常见落点（pipx 链接 / pip --user / 旧发行版 ~/bin）。
# WSL 非登录 shell（wsl -- bash -c）与最小化环境不读 ~/.profile，这些目录不在
# PATH，仅用 command -v 会把"已安装"误判成"缺少 compose"。
# $1 = 可执行文件名；找到则打印绝对路径并返回 0。
find_companion() {
    local name="$1" d
    [ -n "${HOME:-}" ] || return 1
    for d in "$HOME/.local/bin" "$HOME/bin"; do
        if [ -x "$d/$name" ]; then printf '%s\n' "$d/$name"; return 0; fi
    done
    return 1
}

compose_missing_die() {
    if [ "$1" = podman ]; then
        die "Podman 已安装但缺少 compose 支持：
  安装（任选其一）:
    pipx install podman-compose
    python3 -m pip install --user podman-compose
  若已安装仍报此错（常见于 WSL 非登录 shell / 最小化环境），执行:
    export PATH=\"\$HOME/.local/bin:\$PATH\""
    fi
    die "Docker 已安装但缺少 compose 插件：
  安装 Docker Compose v2 插件，或安装独立版:
    pipx install docker-compose
  若已安装仍报此错，确认其目录（如 ~/.local/bin）在 PATH 中"
}

detect_runtime() {
    local cc_path choice
    # 优先级：命令行 --runtime > 环境变量 XMNN_RUNTIME > auto（自动探测）
    choice="${CLI_RUNTIME:-${XMNN_RUNTIME:-auto}}"
    case "$choice" in
        podman|docker)
            RT="$choice"
            command -v "$RT" >/dev/null 2>&1 \
                || die "指定的容器运行时 $RT 未安装或不在 PATH；可改用 auto 自动探测" ;;
        auto|"")
            if command -v podman >/dev/null 2>&1; then RT=podman
            elif command -v docker >/dev/null 2>&1; then RT=docker
            else die "未找到 podman 或 docker，请先安装容器运行时后重试"; fi ;;
        *) die "运行时只允许 podman|docker|auto（当前：$choice）" ;;
    esac
    case "$RT" in
        podman)
            if podman compose version >/dev/null 2>&1; then
                COMPOSE=(podman compose)
            elif command -v podman-compose >/dev/null 2>&1; then
                COMPOSE=(podman-compose)
            elif cc_path="$(find_companion podman-compose)"; then
                COMPOSE=("$cc_path")
                c_warn "podman-compose 不在 PATH，已自动启用：$cc_path"
                c_warn "建议将其目录加入 PATH（WSL 非登录 shell：export PATH=\"\$HOME/.local/bin:\$PATH\"）"
            else compose_missing_die podman; fi
            FILES=(-f compose.yaml -f compose.podman.yaml)
            RUN_FLAGS=(--device /dev/fuse --security-opt label=disable --cgroupns host) ;;
        docker)
            if docker compose version >/dev/null 2>&1; then
                COMPOSE=(docker compose)
            elif command -v docker-compose >/dev/null 2>&1; then
                COMPOSE=(docker-compose)
            elif cc_path="$(find_companion docker-compose)"; then
                COMPOSE=("$cc_path")
                c_warn "docker-compose 不在 PATH，已自动启用：$cc_path"
            else compose_missing_die docker; fi
            FILES=(-f compose.yaml)
            RUN_FLAGS=() ;;
    esac
}

# ── .env 读取与初始化 ────────────────────────────────────────────────────────

env_value() {
    [ -f .env ] || { printf ''; return; }
    local line
    line="$(grep -E "^$1=" .env | tail -n 1 || true)"
    # tr 去 CR：容忍 Windows 编辑器/旧版脚本产生的 CRLF 行尾
    printf '%s' "${line#*=}" | tr -d '\r'
}

ensure_env() {
    [ -f .env ] || { c_warn "未发现 .env，先执行初始化"; do_init; }
}

new_alnum() {
    # $1 = 长度。字符集仅 [A-Za-z0-9]：凭证中的 shell 元字符会被基底
    # entrypoint 的 heredoc 展开，导致实际值与 .env 不一致。
    local n="$1" out
    out="$(LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c "$n" || true)"
    [ "${#out}" -eq "$n" ] || die "凭证生成失败（系统随机源不可用）"
    printf '%s' "$out"
}

set_env_key() {
    # -i.bak 同时兼容 GNU sed 与 macOS BSD sed
    sed -i.bak "s|^$1=.*|$1=$2|" .env
    rm -f .env.bak
}

do_init() {
    if [ -f .env ] && [ "${1:-}" != "--force" ]; then
        c_info ".env 已存在，跳过初始化（./xmnnctl init --force 可重新生成凭证）"
        return
    fi
    [ -f .env.example ] || die "缺少 .env.example，交付包不完整"
    cp .env.example .env
    set_env_key USER_PASSWORD "$(new_alnum 16)"
    set_env_key JUPYTER_TOKEN "$(new_alnum 32)"
    chmod 600 .env 2>/dev/null || true
    c_ok "初始化完成，配置写入 .env"
    printf '    SSH 登录密码 : %s\n' "$(env_value USER_PASSWORD)"
    printf '    Jupyter Token: %s\n' "$(env_value JUPYTER_TOKEN)"
    c_warn "请妥善保存凭证；不要将容器日志直接外发（日志可能含凭证）"
}

# ── 交付清单解析与完整性校验（release.json schema v2）────────────────────────
#
# ⚠️ schema v2 的 payload 与 archive 两个块**都含 "sha256" 键**：抓「全局第一个
# sha256」的旧写法必然张冠李戴（把底座归档摘要当成载荷摘要），故一律按块定向
# 取值。只用 POSIX 自带工具（awk/grep/sed），不引入 jq 等外部依赖。

# manifest_block_field <块名> <键名> → 打印字段值；块/键缺失时无输出且返回 1。
#   块名传 "-"（或空）表示顶层字段（如 "version"）；顶层的取值只在最外层对象
#   的直接子键上匹配，绝不会误取同名的嵌套键（如 payload.version）。
manifest_block_field() {
    local block="$1" key="$2"
    [ -f artifacts/release.json ] || return 1
    awk -v want_block="$block" -v want_key="$key" '
        { text = text $0 "\n" }
        END {
            n = length(text)
            seg = text
            # 顶层：键位于最外层对象内（深度 1）；块内：剥掉块的括号后深度 0
            wdepth = 1
            if (want_block != "" && want_block != "-") {
                bs = index(text, "\"" want_block "\"")
                if (bs == 0) exit 1
                ob = 0
                for (p = bs; p <= n; p++) {
                    if (substr(text, p, 1) == "{") { ob = p; break }
                }
                if (ob == 0) exit 1
                depth = 1
                q = ob + 1
                while (q <= n && depth > 0) {
                    c = substr(text, q, 1)
                    if (c == "{") depth++
                    else if (c == "}") depth--
                    q++
                }
                if (depth != 0) exit 1
                seg = substr(text, ob + 1, q - ob - 2)
                wdepth = 0
            }
            m = length(seg)
            depth = 0
            i = 1
            while (i <= m) {
                c = substr(seg, i, 1)
                if (c == "{") { depth++; i++; continue }
                if (c == "}") { depth--; i++; continue }
                if (c != "\"") { i++; continue }
                j = i + 1
                while (j <= m && substr(seg, j, 1) != "\"") j++
                if (j > m) exit 1
                str = substr(seg, i + 1, j - i - 1)
                # 字符串后紧跟 ":" 才是键；字符集阈值外的逗号/花括号都是值
                k = j + 1
                while (k <= m && substr(seg, k, 1) ~ /[[:space:]]/) k++
                if (substr(seg, k, 1) != ":") { i = j + 1; continue }
                k++
                while (k <= m && substr(seg, k, 1) ~ /[[:space:]]/) k++
                if (depth == wdepth && str == want_key) {
                    if (substr(seg, k, 1) == "\"") {
                        e = k + 1
                        while (e <= m && substr(seg, e, 1) != "\"") e++
                        print substr(seg, k + 1, e - k - 1)
                        exit 0
                    }
                    e = k
                    while (e <= m && substr(seg, e, 1) !~ /[,[:space:]}]/) e++
                    v = substr(seg, k, e - k)
                    gsub(/^[[:space:]]+|[[:space:]]+$/, "", v)
                    print v
                    exit 0
                }
                i = j + 1
            }
            exit 1
        }
    ' artifacts/release.json
}

# 交付版本（顶层 version，即载荷版本；派生镜像 tag = .env 的 XMNN_VERSION 须与之一致）
manifest_version_field() { manifest_block_field "-" version; }

# shasum 优先级：GNU coreutils → Perl shasum（macOS/BSD）→ 空（调用方降级为告警）
sha256_of() {
    local out=""
    if command -v sha256sum >/dev/null 2>&1; then
        out="$(sha256sum "$1" | cut -d' ' -f1)"
    elif command -v shasum >/dev/null 2>&1; then
        out="$(shasum -a 256 "$1" | cut -d' ' -f1)"
    fi
    printf '%s' "$out" | tr 'A-Z' 'a-z'
}

# verify_sha256 <文件> <期望 sha256> <中文名>
# 期望值为空（清单未记录）或无 sha256 工具时降级为告警；不一致即 die。
verify_sha256() {
    local actual expected
    expected="$(printf '%s' "${2:-}" | tr 'A-Z' 'a-z')"
    if [ -z "$expected" ]; then
        c_warn "$3：清单未记录 sha256，跳过完整性校验"
        return 0
    fi
    actual="$(sha256_of "$1")"
    if [ -z "$actual" ]; then
        c_warn "未找到 sha256sum/shasum，跳过 $3 完整性校验"
        return 0
    fi
    [ "$actual" = "$expected" ] \
        || die "完整性校验失败：$3 的 sha256 与交付清单不符，文件可能在拷贝中损坏（请重新获取交付包）：$1"
    c_ok "完整性校验通过：$3（sha256 一致）"
}

# 守护进程可达性预检：CLI 已安装（detect_runtime 只查 PATH）不等于后台
# 虚拟机/daemon 在运行。不预检会让 load 对 1.2GB 包失败后继续重试，
# 最终误报"镜像中没有/版本不符"，掩盖"socket 连不上"的真实原因。
assert_runtime_alive() {
    "$RT" info >/dev/null 2>&1 || {
        if [ "$RT" = podman ]; then
            die "无法连接 Podman 后台（Linux 虚拟机未运行）：请先执行 podman machine start（或启动 Podman Desktop 等待托盘就绪）后重试"
        else
            die "无法连接 Docker 后台：请先启动 Docker Desktop 并等待托盘图标变为运行状态后重试"
        fi
    }
}

# 镜像 Id 读取（容器运行时不可用/镜像不存在时为空）；podman 与 docker 的 Id
# 前缀不一致（一方带 sha256:），比对前统一剥前缀。
image_id_of() {
    "$RT" image inspect --format '{{.Id}}' "$1" 2>/dev/null | head -n 1 | tr -d '\r' || true
}

# image_id_matches <镜像 ref> <清单记录的 Id>：本机镜像与交付清单同源时返回 0
image_id_matches() {
    local actual want
    actual="$(image_id_of "$1")"
    [ -n "$actual" ] || return 1
    actual="${actual#sha256:}"
    want="${2#sha256:}"
    [ -n "$want" ] || return 1
    [ "$actual" = "$want" ]
}

# ── load：导入底座 + 派生载荷（复合流程，幂等）───────────────────────────────
#
# 交付包只随带两份大制品：底座归档（约 1.1 GB，artifacts/）与载荷 wheel
# （约 177 MB，payload/）。load 的语义是：
#   ① 运行时存活预检 → ② 读 artifacts/release.json 并自检版本一致
#   ③ 底座：本机已有同 Id 镜像则跳过导入，否则校验 sha256 后 load 并复核 Id
#   ④ 载荷：校验 payload/ 内 wheel 的 sha256
#   ⑤ 派生构建：把载荷装入底座（构建内已含守卫与 pip check，失败即不产出 tag）
# 只换载荷的更新交付不必重传 1.1 GB 归档（③ 命中跳过）。
do_load() {
    assert_runtime_alive
    [ -f artifacts/release.json ] \
        || die "交付包不完整：缺 artifacts/release.json（请确认交付包已完整解压）"
    local schema mver ver base_ref base_id archive_file archive_sha payload_file payload_sha img_ref
    schema="$(manifest_block_field "-" schema_version || true)"
    if [ -n "$schema" ] && [ "$schema" != "2" ]; then
        die "交付清单版本不受支持：artifacts/release.json 的 schema_version=$schema（本脚本需要 2）
  说明：旧清单没有独立载荷信息，无法派生构建；请使用与交付包成套的新版 xmnnctl 重试"
    fi
    mver="$(manifest_version_field || true)"
    base_ref="$(manifest_block_field image ref || true)"
    base_id="$(manifest_block_field image id || true)"
    archive_file="$(manifest_block_field archive file || true)"
    archive_sha="$(manifest_block_field archive sha256 || true)"
    payload_file="$(manifest_block_field payload file || true)"
    payload_sha="$(manifest_block_field payload sha256 || true)"
    [ -n "$mver" ] && [ -n "$base_ref" ] && [ -n "$base_id" ] \
        && [ -n "$archive_file" ] && [ -n "$payload_file" ] \
        || die "交付包不完整：artifacts/release.json 缺少必需字段（version / image.ref / image.id / archive.file / payload.file）
  处理方式：重新获取完整交付包（清单与制品必须成套），或联系交付方核对"
    ver="$(env_value XMNN_VERSION)"
    [ -n "$ver" ] || die ".env 缺少 XMNN_VERSION（先执行 ./xmnnctl init 生成 .env）"
    if [ "$ver" != "$mver" ]; then
        die "版本不一致：.env 的 XMNN_VERSION=$ver，交付清单 version=$mver
  修法：把 .env 中的 XMNN_VERSION 改为 $mver（交付版本以清单为准），再重新执行 ./xmnnctl load"
    fi

    # ③ 底座镜像
    if image_id_matches "$base_ref" "$base_id"; then
        c_info "底座已在本机，跳过导入：$base_ref"
    else
        [ -f "artifacts/$archive_file" ] \
            || die "交付包不完整：缺少底座归档 artifacts/$archive_file（请确认交付包已完整解压）"
        verify_sha256 "artifacts/$archive_file" "$archive_sha" "底座归档"
        c_info "导入底座镜像：artifacts/$archive_file（约 1-5 分钟）"
        "$RT" load -i "artifacts/$archive_file" \
            || die "镜像导入失败：请查看上方 $RT 的原始报错（常见原因：磁盘空间不足）；处理后重新执行 load 即可，导入过程幂等"
        image_id_matches "$base_ref" "$base_id" \
            || die "交付包与镜像不匹配：导入后 $base_ref 的 Id 与清单记录的 ${base_id:0:12}… 不一致
  处理方式：归档与清单一同重新获取（必须成套），或联系交付方核对"
    fi
    c_ok "底座镜像就绪：$base_ref"

    # ④ 载荷 wheel（构建上下文 = payload/ 目录）
    [ -f "payload/$payload_file" ] \
        || die "交付包不完整：缺少载荷 wheel payload/$payload_file
  载荷应与 artifacts/ 同级放在 payload/ 目录内；请确认交付包已完整解压后重试"
    verify_sha256 "payload/$payload_file" "$payload_sha" "载荷 wheel"
    [ -f payload/Dockerfile ] \
        || die "交付包不完整：缺少派生构建文件 payload/Dockerfile（请重新获取交付包）"

    # ⑤ 派生构建（离线装载荷 + 构建期守卫；失败即中止，不产出 tag）
    img_ref="localhost/xmnn-runtime:$ver"
    c_info "派生构建载荷镜像：$img_ref（离线安装 + 10 项守卫，约 1-3 分钟）"
    "$RT" build -f payload/Dockerfile \
        --build-arg "BASE_IMAGE=$base_ref" \
        --build-arg "PAYLOAD_VERSION=$ver" \
        -t "$img_ref" payload \
        || die "派生构建失败：请查看上方 $RT 的原始报错；构建全程离线（与网络无关），常见原因：
  - 磁盘空间不足（派生镜像另需约 0.2 GB）
  - 底座与载荷不匹配（构建日志中 pip check 报缺依赖）——请把上方报错反馈给交付方
  处理后重新执行 ./xmnnctl load 即可（幂等，底座已导入时不会重复导入）"
    c_ok "载荷已装入 $img_ref"
    c_info "下一步：./xmnnctl up（如需复核守卫可执行 ./xmnnctl smoke）"
}

# ── compose 包装与服务管理 ──────────────────────────────────────────────────

compose() { "${COMPOSE[@]}" "${FILES[@]}" "$@"; }

do_down() { compose down; c_ok "已停止（workspace 与 SSH host key 卷保留）"; }
do_ps()   { compose ps; }
do_logs() { compose logs -f --tail 100; }

wait_ready() {
    # 轮询 Jupyter 直到返回 2xx/3xx（冷启动含基底初始化，约 1-3 分钟）
    local port="$1" i=0 code
    while [ "$i" -lt 150 ]; do
        if command -v curl >/dev/null 2>&1; then
            code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 3 \
                    "http://127.0.0.1:$port/lab" || true)"
        elif (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then
            code=302; exec 3>&- 2>/dev/null || true
        else
            code="000"
        fi
        case "$code" in 2*|3*) return 0 ;; esac
        sleep 2
        i=$((i+1))
    done
    return 1
}

print_banner() {
    local sport jport ver
    sport="$(env_value XMNN_SSH_PORT)"; sport="${sport:-2225}"
    jport="$(env_value XMNN_JUPYTER_PORT)"; jport="${jport:-8893}"
    ver="$(env_value XMNN_VERSION)"
    printf '\n============================================================\n'
    printf ' XMNN Runtime %s 已启动\n' "$ver"
    printf ' JupyterLab : http://localhost:%s\n' "$jport"
    printf '              内核选择 Python 3.14 (xmnn runtime)\n'
    printf ' SSH        : ssh -p %s devuser@localhost\n' "$sport"
    printf ' 工作区     : ./workspace （容器内 /workspace）\n'
    printf ' 凭证       : .env（USER_PASSWORD / JUPYTER_TOKEN）\n'
    printf ' 停止       : ./xmnnctl down\n'
    printf '============================================================\n\n'
}

# ── 宿主端口预检（up 前 fail-fast）──────────────────────────────────────────
#
# podman rootless 与 docker 共享同一个宿主网络命名空间：rootless 的端口转发
# 表现为宿主用户进程（rootlessport），另一引擎的容器列表/元数据完全看不到它。
# 只查 "$RT ps" 会漏掉跨引擎占用，直到 compose up 绑定阶段才被内核拒绝
# （"bind: address already in use"），且报错不指认占用者。预检必须直接探测
# 宿主网络栈：ss（Linux 常规）→ /dev/tcp（bash 内建，macOS/最小环境）→ netstat。

# $1=端口；占用返回 0（占用者描述写全局 PORT_HOLDER），空闲返回 1。
port_holder() {
    local port="$1" line pid comm
    PORT_HOLDER=""
    if command -v ss >/dev/null 2>&1; then
        line="$(LC_ALL=C ss -ltnp 2>/dev/null \
            | awk -v p="$port" 'NR>1 {n=split($4,a,":"); if (a[n]==p) {print; exit}}')"
        [ -n "$line" ] || return 1
        pid="$(printf '%s' "$line" | grep -o 'pid=[0-9]*' | head -n1 | cut -d= -f2 || true)"
        if [ -n "$pid" ] && [ -r "/proc/$pid/comm" ]; then
            comm="$(tr -d '\n' </proc/$pid/comm 2>/dev/null || true)"
            PORT_HOLDER="${comm:-未知进程}（pid=$pid）"
        else
            PORT_HOLDER="未知进程（属主为其他用户，可用 sudo ss -ltnp 查看）"
        fi
        return 0
    fi
    # 无 ss（macOS/极简系统）：bash 内建 /dev/tcp 发起本机连接
    if (exec 3<>"/dev/tcp/127.0.0.1/$port") 2>/dev/null; then
        exec 3>&- 2>/dev/null || true
        PORT_HOLDER="未知进程（经 /dev/tcp 探测确认）"
        return 0
    fi
    if command -v netstat >/dev/null 2>&1 \
       && LC_ALL=C netstat -an 2>/dev/null | grep -Eq "[.:]$port[[:space:]].*LISTEN"; then
        PORT_HOLDER="未知进程（经 netstat 探测确认）"
        return 0
    fi
    return 1
}

# 本引擎同名容器自身是否已发布该端口。重复 up / 改配置重建时 compose 先停旧
# 容器再绑定，不会与自己冲突——此情形豁免（仅告警），避免预检误杀幂等重入。
# $1=容器名 $2=端口；已发布返回 0。
self_publishes_port() {
    local cname="$1" port="$2" ports
    ports="$("$RT" ps --filter "name=^${cname}$" --format '{{.Ports}}' 2>/dev/null || true)"
    printf '%s' "$ports" | grep -Eq ":$port->"
}

preflight_ports() {
    local cname sport jport p other
    cname="$(env_value XMNN_CONTAINER_NAME)"; cname="${cname:-xmnn-runtime}"
    sport="$(env_value XMNN_SSH_PORT)"; sport="${sport:-2225}"
    jport="$(env_value XMNN_JUPYTER_PORT)"; jport="${jport:-8893}"
    for p in "$sport" "$jport"; do
        case "$p" in ''|*[!0-9]*) die ".env 端口配置非法：$p（应为 1-65535 的数字）" ;; esac
        port_holder "$p" || continue
        if self_publishes_port "$cname" "$p"; then
            c_warn "宿主端口 $p 已由本运行时（$RT）的容器 $cname 发布；up 将原地更新该容器"
            continue
        fi
        if [ "$RT" = podman ]; then other=docker; else other=podman; fi
        die "宿主端口 $p 已被占用：$PORT_HOLDER
  容器引擎之间互不可见对方的端口占用——这通常是另一运行时（$other）已启动
  同名容器，或本机其他程序占用了该端口。
  排查命令：ss -ltnp | grep ':$p'      （或 lsof -iTCP:$p -sTCP:LISTEN）
  处理方式（二选一）：
    1) 切换到 $RT：先停掉另一运行时的实例
         ./xmnnctl -r $other down
       （down 删除容器但保留 workspace 与 SSH host key 卷；只想停用、保留
         容器可回退执行 $other stop $cname）
    2) 两套实例长期并存：复制一份独立交付目录，在其 .env 中同时修改
       XMNN_SSH_PORT / XMNN_JUPYTER_PORT（换空闲端口）与 XMNN_CONTAINER_NAME，
       且不要让两个实例映射同一个 workspace 目录"
    done
}

do_up() {
    mkdir -p workspace
    assert_runtime_alive
    preflight_ports
    local jport
    c_info "启动 xmnn-runtime（$RT）"
    compose up -d
    jport="$(env_value XMNN_JUPYTER_PORT)"; jport="${jport:-8893}"
    c_info "等待 Jupyter 就绪（冷启动约需 1-3 分钟）"
    if wait_ready "$jport"; then c_ok "服务已就绪"; else
        c_warn "限定时间内未检测到 Jupyter 响应，请用 ./xmnnctl logs 查看启动进度"
    fi
    print_banner
}

# ── 运行时守卫 ──────────────────────────────────────────────────────────────

container_running() {
    "$RT" ps --format '{{.Names}}' 2>/dev/null | grep -Fx "$1" >/dev/null 2>&1
}

do_smoke() {
    assert_runtime_alive
    local cname ver img_ref
    cname="$(env_value XMNN_CONTAINER_NAME)"; cname="${cname:-xmnn-runtime}"
    ver="$(env_value XMNN_VERSION)"
    [ -n "$ver" ] || die ".env 缺少 XMNN_VERSION；请先 ./xmnnctl init"
    # 守卫跑的是**派生镜像**（载荷由 load 装入底座后产出），底座不含载荷
    img_ref="localhost/xmnn-runtime:$ver"
    if container_running "$cname"; then
        c_info "容器运行中，经 exec 执行守卫"
        "$RT" exec "$cname" /opt/conda/bin/python /opt/xmnnrt-smoke/_runtime_smoke.py
    else
        if [ -z "$(image_id_of "$img_ref")" ]; then
            die "本机没有派生镜像 $img_ref：请先执行 ./xmnnctl load（把 payload/ 内载荷装入底座）后再跑 smoke"
        fi
        c_info "容器未运行，使用派生镜像 $img_ref 的一次性容器执行守卫"
        # 必须显式 --entrypoint：镜像默认 entrypoint 的命令模式会把脚本交给
        # cp314t 登录环境解析（实测会 9 项失败）。
        "$RT" run --rm ${RUN_FLAGS[@]+"${RUN_FLAGS[@]}"} \
            --entrypoint /opt/conda/bin/python "$img_ref" \
            /opt/xmnnrt-smoke/_runtime_smoke.py
    fi
}

# ── 版本信息 ────────────────────────────────────────────────────────────────

do_version() {
    local ver mver base_ref base_id payload_file payload_sha archive_file archive_sha
    ver="$(env_value XMNN_VERSION)"
    printf 'xmnn-runtime release: %s\n' "${ver:-未知（请先 ./xmnnctl init）}"
    if [ ! -f artifacts/release.json ]; then
        c_warn "未找到 artifacts/release.json，无法显示交付清单摘要"
        return 0
    fi
    mver="$(manifest_version_field || true)"
    base_ref="$(manifest_block_field image ref || true)"
    base_id="$(manifest_block_field image id || true)"
    payload_file="$(manifest_block_field payload file || true)"
    payload_sha="$(manifest_block_field payload sha256 || true)"
    archive_file="$(manifest_block_field archive file || true)"
    archive_sha="$(manifest_block_field archive sha256 || true)"
    printf '交付版本   : %s\n' "${mver:-未记录}"
    printf '底座镜像   : %s（Id %s）\n' "${base_ref:-未记录}" "${base_id:0:12}"
    printf '载荷 wheel : %s（sha256 %s）\n' "${payload_file:-未记录}" "${payload_sha:0:12}"
    printf '底座归档   : %s（sha256 %s）\n' "${archive_file:-未记录}" "${archive_sha:0:12}"
}

# ── 入口分发 ────────────────────────────────────────────────────────────────

main() {
    parse_global_args "$@"
    set -- ${REMAIN[@]+"${REMAIN[@]}"}
    local cmd="${1:-}"
    [ -n "$cmd" ] || { usage; exit 1; }
    shift
    case "$cmd" in
        init)    detect_runtime; do_init "${1:-}" ;;
        load)    detect_runtime; ensure_env; do_load ;;
        up)      detect_runtime; ensure_env; do_up ;;
        down)    detect_runtime; ensure_env; do_down ;;
        ps)      detect_runtime; ensure_env; do_ps ;;
        logs)    detect_runtime; ensure_env; do_logs ;;
        smoke)   detect_runtime; ensure_env; do_smoke ;;
        version) do_version ;;
        -h|--help|help) usage ;;
        *) die "未知命令：$cmd（支持 init/load/up/down/ps/logs/smoke/version）" ;;
    esac
}

main "$@"
