# ============================================================================
# xmnn-runtime 客户配置模板
#
# 用法：由 `./xmnnctl init`（Windows: ./xmnnctl.ps1 init）自动复制为 .env，
#       并自动生成 USER_PASSWORD / JUPYTER_TOKEN；一般无需手工编辑。
#       如需固定凭证或端口，可在 init 后修改 .env 并重新 up。
# ============================================================================

# 交付版本（须与随包镜像 tar.gz、release.json 一致；修改需匹配已导入镜像）
XMNN_VERSION=1.2.1.dev0

# 容器名（多实例并存时可修改）
XMNN_CONTAINER_NAME=xmnn-runtime

# 宿主端口（默认 SSH 2225 / Jupyter 8893；如被占用可修改）
XMNN_SSH_PORT=2225
XMNN_JUPYTER_PORT=8893

# ----------------------------------------------------------------------------
# 凭证（init 自动生成；留空时容器首次启动会另行生成，但推荐由 init 管理）
# ----------------------------------------------------------------------------
# SSH 登录密码（用户 devuser）
USER_PASSWORD=
# JupyterLab 访问 Token
JUPYTER_TOKEN=
# 可选：SSH 公钥（写入后可用密钥登录，整行粘贴，例如 ssh-ed25519 AAAA...）
SSH_PUBLIC_KEY=
# 是否授予 devuser sudo 权限：yes|no
GRANT_SUDO=yes
