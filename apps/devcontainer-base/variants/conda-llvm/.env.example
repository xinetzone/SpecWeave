# =============================================================================
# devcontainer-base Conda-LLVM Variant - 环境变量/构建参数配置模板
# =============================================================================
# 使用方式：在 variants/conda-llvm/ 目录下 cp .env.example .env，然后按需修改
# 构建脚本 variants/build.sh 会自动加载此文件
# =============================================================================

# ─── 基础镜像标签 ──────────────────────────────────────────────────────────
# 基础镜像 devcontainer-base:conda-* 的标签，默认 latest
BASE_TAG=latest

# ─── 镜像源配置（构建时使用，继承自 conda 变体）────────────────────────────
# APT 源: official(默认, Ubuntu官方) | aliyun(阿里云) | tuna(清华TUNA)
APT_MIRROR=official

# Conda 源: tuna(默认, 清华TUNA镜像) | official(Anaconda官方)
CONDA_MIRROR=tuna

# PyPI pip 源: aliyun(默认, 阿里云) | tuna(清华TUNA) | official(PyPI官方)
PIP_MIRROR=aliyun

# ─── LLVM 工具链配置 ──────────────────────────────────────────────────────
# LLVM 版本（llvmdev, clangdev, clang, lld, lldb 统一版本）
LLVM_VERSION=22.1.8
