# =============================================================================
# devcontainer-base Variant Template - 环境变量/构建参数配置模板
# =============================================================================
# 使用方式：在 variants/&lt;variant-name&gt;/ 目录下 cp .env.example .env，然后按需修改
# 构建脚本 variants/build.sh 会自动加载此文件
# =============================================================================

# ─── 基础镜像标签 ──────────────────────────────────────────────────────────
# 基础镜像 devcontainer-base 的标签，默认 latest
BASE_TAG=latest

# 如果依赖其他变体，指定依赖变体的标签（通常与 BASE_TAG 保持一致）
# BASE_VARIANT_TAG=latest

# ─── 镜像源配置（构建时使用）────────────────────────────────────────────────
# APT 源: official(默认, Ubuntu官方) | aliyun(阿里云) | tuna(清华TUNA)
APT_MIRROR=official

# Conda 源: tuna(默认, 清华TUNA镜像) | official(Anaconda官方)
CONDA_MIRROR=tuna

# PyPI pip 源: aliyun(默认, 阿里云) | tuna(清华TUNA) | official(PyPI官方)
PIP_MIRROR=aliyun

# ─── Miniconda 配置（如果需要 conda）───────────────────────────────────────
# Miniconda 版本: latest(默认) 或指定版本号如 py24.9.2-0
MINICONDA_VERSION=latest

# Conda base 环境默认 Python 版本
PYTHON_VERSION=3.14

# ─── 变体特有构建参数 ──────────────────────────────────────────────────────
# __EXTRA_BUILD_ARGS__
# 请在此处添加变体特有的构建参数，例如：
# LLVM_VERSION=22.1.8
# NODE_VERSION=22
# GO_VERSION=1.24
