# =============================================================================
# devcontainer-base ONNX-PyTorch Variant - 环境变量/构建参数配置模板
# =============================================================================
# 使用方式：在 variants/onnx-pytorch/ 目录下 cp .env.example .env，然后按需修改
# 构建脚本 variants/build.sh 会自动加载此文件
# =============================================================================

# ─── 基础镜像标签 ──────────────────────────────────────────────────────────
# 基础镜像 devcontainer-base:conda-llvm-* 的标签，默认 latest
# 依赖链：devcontainer-base:latest -> devcontainer-base:conda-* -> devcontainer-base:conda-llvm-*
BASE_TAG=latest

# ─── 镜像源配置（构建时使用，继承自 conda-llvm 变体）──────────────────────
# APT 源: official(默认, Ubuntu官方) | aliyun(阿里云) | tuna(清华TUNA)
APT_MIRROR=official

# Conda 源: tuna(默认, 清华TUNA镜像) | official(Anaconda官方)
CONDA_MIRROR=tuna

# PyPI pip 源: aliyun(默认, 阿里云) | tuna(清华TUNA) | official(PyPI官方)
# 注意：PyTorch CPU 版使用独立索引下载（见下方 TORCH_INDEX_URL），
#       普通 pip 包（onnx/onnxruntime 等）仍使用本配置
PIP_MIRROR=aliyun

# ─── PyTorch 安装索引 ─────────────────────────────────────────────────────
# PyTorch CPU 版专用 wheel 索引（不含 CUDA，体积小）
# 官方 CPU 索引: https://download.pytorch.org/whl/cpu
# 若该索引在所处网络不可达，可改用清华镜像:
#   https://mirrors.tuna.tsinghua.edu.cn/pytorch-wheels/cpu
TORCH_INDEX_URL=https://download.pytorch.org/whl/cpu
