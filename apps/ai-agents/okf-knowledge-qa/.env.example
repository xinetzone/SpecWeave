# 大模型配置（OpenAI 兼容协议）
# 换用其他厂商只需改 LLM_BASE_URL 与 LLM_MODEL，例如：
#   DeepSeek  : LLM_BASE_URL=https://api.deepseek.com/v1        LLM_MODEL=deepseek-chat
#   通义千问  : LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#   Moonshot  : LLM_BASE_URL=https://api.moonshot.cn/v1          LLM_MODEL=moonshot-v1-8k
LLM_BASE_URL=https://api.openai.com/v1
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# —— 以下均为可选，留空即用默认值 ——
# 未配置 LLM_API_KEY 时服务不会启动失败，而是降级为「抽取式片段直出 + 出处引用」。

# 检索返回的片段数量（1-20，默认 6）
# TOP_K=6
# 送入大模型的上下文字符上限（默认 6000）
# MAX_CONTEXT_CHARS=6000
# 大模型请求超时秒数（默认 45，需小于 Vercel 的 maxDuration）
# LLM_TIMEOUT=45
