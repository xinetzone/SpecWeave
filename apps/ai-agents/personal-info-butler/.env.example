# 个人信息管家 Agent —— 环境变量模板
# 复制为 .env 后填写（.env 不入库）。未填写的项会自动降级，不会崩溃。

# ---- 云端存储（WorkBuddy 云服务 / Supabase / PostgreSQL）---------------------
# 三种存储实现，优先级：WorkBuddy 云服务 > Supabase > 进程内存。
#
# WorkBuddy 云服务（平台托管，发布到平台时由平台注入）：
#   数据面路径 /.cloud/database/rest/<table>，鉴权头 x-wb-webapp-access-key。
#   endpoint 与 publishableKey 必须成对出现，缺一即整体降级。
WB_CLOUD_ENDPOINT=
WB_PUBLISHABLE_KEY=
# 云端免密钥大模型使用的模型名（留空则云端大模型不启用）
WB_LLM_MODEL=

# Supabase / PostgreSQL（自建云库时用；两者同时为空 → 退回进程内存）
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- 大模型（任何 OpenAI 兼容端点）------------------------------------------
# 留空 LLM_API_KEY → 全部 AI 能力降级为启发式/统计直出，应用仍可用。
# 优先级：页面 BYOK > 云端免密钥通道 > 这里的服务端配置。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---- 访问鉴权 ---------------------------------------------------------------
# 留空则不鉴权（仅限本地）。上线必须设置，前端在「设置」里填同一个值。
APP_TOKEN=

# ---- CORS ------------------------------------------------------------------
# 逗号分隔；* 表示放开（演示用）。**同源部署下前端与 API 同域，不需要 CORS**，
# 这个变量只在前端与 API 分处两处时才起作用。
CORS_ORIGINS=*

# ---- 前端静态资源 -----------------------------------------------------------
# 同源模式（--static）下前端构建产物的位置；默认 _build/html。
BUTLER_STATIC_DIR=

# ---- Sphinx 构建期注入 ------------------------------------------------------
# 静态站与 API 分处两处时，构建时把这个值写进页面，读者打开站点即可直连，
# 无需手动配置。留空则前端走同源 /api/*（同源部署下必须留空）。
BUTLER_API_BASE=
