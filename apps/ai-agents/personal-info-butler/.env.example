# 个人信息管家 Agent —— 环境变量模板
# 复制为 .env 后填写（.env 不入库）。未填写的项会自动降级，不会崩溃。

# ---- 云端存储（Supabase / PostgreSQL）--------------------------------------
# 两者同时为空 → 服务退回进程内存存储（重启即失），仅用于本地体验。
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- 大模型（任何 OpenAI 兼容端点）------------------------------------------
# 留空 LLM_API_KEY → 全部 AI 能力降级为启发式/统计直出，应用仍可用。
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---- 访问鉴权 ---------------------------------------------------------------
# 留空则不鉴权（仅限本地）。上线必须设置，前端在「设置」里填同一个值。
APP_TOKEN=

# ---- CORS ------------------------------------------------------------------
# 逗号分隔；* 表示放开（演示用）。上线建议填 Sphinx 站点的确切来源。
CORS_ORIGINS=*

# ---- Sphinx 构建期注入 ------------------------------------------------------
# 静态站发布后，前端默认不知道 API 在哪。构建时把这个值写进页面，
# 读者打开站点即可直连，无需手动配置。留空则前端走同源 /api/*。
BUTLER_API_BASE=
