# ---------------------------------------------------------------------------
# 个人信息管家 Agent —— 环境变量模板（复制为 .env 后填写，切勿提交）
# ---------------------------------------------------------------------------

# 1) 云端存储（Supabase，推荐）：在 Supabase SQL Editor 执行 schema.sql 后填写
SUPABASE_URL=https://xxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 2) 大模型（OpenAI 兼容协议）：DeepSeek / 通义 / 混元 / OpenAI / Moonshot 均可
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxx
LLM_MODEL=deepseek-chat

# 3) 访问令牌（可选但强烈建议）：留空则不校验，任何人可读写你的数据
APP_TOKEN=

# 4) 本地开发端口
PORT=3000
