# ---------------------------------------------------------------------------
# 智能客服 Agent —— 环境变量模板（复制为 .env 后填写，切勿提交）
# ---------------------------------------------------------------------------

# 1) 云端存储（Supabase）：在 Supabase SQL Editor 执行 schema.sql 后填写
SUPABASE_URL=https://xxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 2) 大模型（OpenAI 兼容协议）：DeepSeek / 通义 / 混元 / OpenAI / Moonshot 均可
#    服务端不配置也可以在前端「设置」里 BYOK 自带密钥
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=sk-xxxxxx
LLM_MODEL=deepseek-chat

# 3) 管理后台访问令牌（必填，否则 /api/admin/* 返回 503）
ADMIN_TOKEN=change-me

# 4) 本地开发端口
PORT=8000
