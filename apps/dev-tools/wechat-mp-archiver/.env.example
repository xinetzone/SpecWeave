# ============================================================
# wechat-mp-archiver 配置示例
# 复制为 .env 后按需修改；.env 已在 .gitignore 中，切勿提交真实凭证
# 所有变量统一 MP_ARCHIVER_ 前缀（大小写不敏感）
# ============================================================

# R2 采集服务（wechat-download-api / wechat-article-exporter 私有部署地址）
MP_ARCHIVER_EXPORTER_URL=http://127.0.0.1:5000
# 采集服务静态 Token（如服务启用了鉴权；无则留空）
MP_ARCHIVER_EXPORTER_TOKEN=
# 端点路径覆写（默认留空：从采集服务 OpenAPI 自动发现；
# 实测自动发现不匹配时，用 doctor 输出的能力路径手工指定）
MP_ARCHIVER_EXPORTER_SEARCH_PATH=
MP_ARCHIVER_EXPORTER_HISTORY_PATH=

# 本地归档根目录与 SQLite 数据库路径（相对路径相对于运行目录）
MP_ARCHIVER_ARCHIVE_ROOT=archive
MP_ARCHIVER_DB_PATH=data/archive.db
# 派生产物根目录（export-rag 的 JSONL 默认写入其下 rag.jsonl）
MP_ARCHIVER_EXPORT_ROOT=exports

# 保守限速：每次请求之间的随机间隔（秒），从区间均匀采样
MP_ARCHIVER_REQUEST_DELAY_MIN=2.0
MP_ARCHIVER_REQUEST_DELAY_MAX=5.0
# 失败重试次数与指数退避（秒）：delay = min(cap, base * 2**n) + 抖动
MP_ARCHIVER_MAX_RETRIES=5
MP_ARCHIVER_BACKOFF_BASE=2.0
MP_ARCHIVER_BACKOFF_CAP=60.0
# 单次请求超时（秒）
MP_ARCHIVER_TIMEOUT=30.0
# 可选出站代理（如 http://127.0.0.1:7890）；留空不走代理
MP_ARCHIVER_PROXY_URL=

# 是否采集互动数据（阅读/点赞/评论等）。默认关闭：无公开接口且更易触发风控
# 开启方式二选一：本项置 true，或 fetch 时加 --fetch-metrics
# 开启后必须提供下列互动凭证（appmsg_token + pass_ticket 必需），
# 缺失或失效时相关文章记 skipped_no_credential，正文归档不受影响
MP_ARCHIVER_FETCH_METRICS=false
MP_ARCHIVER_WECHAT_APPSMSG_TOKEN=
MP_ARCHIVER_WECHAT_PASS_TICKET=
MP_ARCHIVER_WECHAT_KEY=
MP_ARCHIVER_WECHAT_WXUIN=

# R1 条件补充：自有认证公众号官方接口凭证（不采集自有号可留空）
# 边界：官方文档适用范围仅列认证服务号（认证订阅号以后台接口权限页与
# 实测为准）；2025-07 起个人/未认证主体返回 48001。该接口只覆盖
# "已发布图文"（含发表不通知），不含群发历史，历史全量仍以 R2 采集服务
# 为主。详见 deploy/README.md 第 11 节
MP_ARCHIVER_WECHAT_APP_ID=
MP_ARCHIVER_WECHAT_APP_SECRET=
# 官方接口不返回 __biz：优先按账号别名从已同步的 R2 数据解析；
# 未做过 R2 同步时在此显式填写（形如 MzA...%3D%3D 的 Base64 串）
MP_ARCHIVER_WECHAT_OFFICIAL_BIZ=
# batchget 单日调用安全阈值（经验日限约 100 次，默认 90 预留余量）
MP_ARCHIVER_OFFICIAL_DAILY_CALL_CAP=90

# 日志级别：DEBUG / INFO / WARNING / ERROR
MP_ARCHIVER_LOG_LEVEL=INFO
