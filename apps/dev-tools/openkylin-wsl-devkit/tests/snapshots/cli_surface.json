                "choices": [
                  {
                    "name": "preflight",
                    "parser": {
                      "prog": "okw ai preflight",
                      "description": "只读预检，单条 apt-cache policy 批量盘点；不触发 apt update、不写文件、不改默认发行版。OCR 必选组件有候选标 PASS；可选层缺失标 UNKNOWN 不阻断；索引过期给出手动 apt update 建议，网络错误给出排查方向。",
                      "epilog": "退出码：0=全部 PASS；1=存在 FAIL（按报告中的中文指引修复后重试）；2=用法错误、preflight/verify 仅 UNKNOWN，或 install 未提供 --yes（零写入）。\n边界：okw 不配置 API Key/Token、不下载模型、不安装 ollama；Gen2 全栈仅只读盘点。",
                      "actions": [
                        {
                          "kind": "_StoreAction",
                          "option_strings": [],
                          "dest": "name",
                          "nargs": null,
                          "required": true,
                          "metavar": null,
                          "help": "发行版名称（wsl -l -v 查看）",
                          "default": "None"
                        }
                      ]
                    }
                  },
                  {
                    "name": "install",
                    "parser": {
                      "prog": "okw ai install",
                      "description": "--yes 后：① root apt update 刷新索引；② root apt install -y --no-install-recommends libkylin-ai-base-dev（APT 解析 OCR 运行库、tesseract、chi_sim/eng 语言包）；③ 默认用户只读 OCR 验收。漏 --yes 仅打印 3 条副作用清单、退出码 2、零写入。不改软件源/wsl.conf/默认发行版，不装可选层、模型或 ollama。",
                      "epilog": "退出码：0=全部 PASS；1=存在 FAIL（按报告中的中文指引修复后重试）；2=用法错误、preflight/verify 仅 UNKNOWN，或 install 未提供 --yes（零写入）。\n边界：okw 不配置 API Key/Token、不下载模型、不安装 ollama；Gen2 全栈仅只读盘点。",
                      "actions": [
