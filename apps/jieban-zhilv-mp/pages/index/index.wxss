.hero {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 36rpx 32rpx 28rpx;
  background: linear-gradient(135deg, #2f6bff 0%, #4f8bff 100%);
}

.hero-brand {
  display: flex;
  align-items: center;
  min-width: 0;
}

.hero-mark {
  width: 64rpx;
  height: 64rpx;
  flex: none;
  margin-right: 20rpx;
}

.hero-titles {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.hero-title {
  font-size: 38rpx;
  font-weight: 700;
  color: #fff;
  letter-spacing: 2rpx;
  line-height: 1.2;
}

.hero-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.82);
}

.hero-user {
  display: flex;
  align-items: center;
  flex: none;
  margin-left: 20rpx;
  padding: 10rpx 22rpx 10rpx 12rpx;
  border-radius: 32rpx;
  background: rgba(255, 255, 255, 0.18);
}

.hero-user-action {
  border: 2rpx solid rgba(255, 255, 255, 0.45);
}

.hero-avatar {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
  opacity: 0.95;
}

.hero-user-name {
  font-size: 24rpx;
  color: #fff;
  max-width: 220rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list {
  padding: 24rpx 24rpx 0;
}

/* 发起活动入口 */
.publish-entry {
  display: flex;
  align-items: center;
  margin: 24rpx 24rpx 0;
  padding: 26rpx 28rpx;
  border-radius: var(--radius-lg);
  background: linear-gradient(135deg, #2f6bff 0%, #5b95ff 100%);
  box-shadow: var(--shadow);
}

.publish-entry-icon {
  width: 56rpx;
  height: 56rpx;
  flex: none;
  margin-right: 20rpx;
  opacity: 0.95;
  filter: brightness(0) invert(1);
}

.publish-entry-info {
  flex: 1;
  min-width: 0;
}

.publish-entry-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #fff;
}

.publish-entry-desc {
  display: block;
  margin-top: 8rpx;
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.85);
}

.publish-entry-arrow {
  flex: none;
  margin-left: 12rpx;
  opacity: 0.9;
  filter: brightness(0) invert(1);
}

/* 区块标题 */
.section-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-bottom: 20rpx;
}

.section-head-title {
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.section-head-count {
  font-size: 23rpx;
  color: var(--ink-3);
}

/* 活动模板区块 */
.template-section {
  margin-top: 40rpx;
  padding: 0 24rpx;
}

.template-section-desc {
  display: block;
  margin-top: -8rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: var(--ink-3);
  line-height: 1.6;
}

.template-item {
  display: flex;
  padding: 24rpx;
}

.template-item + .template-item {
  margin-top: 24rpx;
}

.template-cover {
  width: 180rpx;
  height: 180rpx;
  flex: none;
  border-radius: 16rpx;
  background: #dfe4ee;
}

.template-body {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.template-title {
  display: block;
  font-size: 29rpx;
  font-weight: 600;
  color: var(--ink);
}

.template-summary {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ink-2);
  line-height: 1.55;
}

.template-meta {
  display: flex;
  align-items: center;
  margin-top: 14rpx;
}

.template-meta .icon {
  margin-right: 8rpx;
}

.template-meta-icon {
  margin-left: 20rpx;
}

.template-meta-text {
  font-size: 23rpx;
  color: var(--ink-3);
}

.template-btn {
  margin-top: 20rpx;
  height: 76rpx;
  padding: 0 40rpx;
}

.empty-btn {
  margin-top: 32rpx;
  padding: 0 56rpx;
  height: 88rpx;
}

.activity {
  overflow: hidden;
  padding: 0;
}

.activity + .activity {
  margin-top: 24rpx;
}

.activity-cover-wrap {
  position: relative;
  width: 100%;
  height: 300rpx;
  background: #dfe4ee;
}

.activity-cover {
  width: 100%;
  height: 100%;
  display: block;
}

.activity-badge {
  position: absolute;
  left: 24rpx;
  bottom: 20rpx;
  padding: 8rpx 20rpx;
  border-radius: 24rpx;
  background: rgba(31, 39, 51, 0.72);
  color: #fff;
  font-size: 22rpx;
}

.activity-body {
  padding: 28rpx 28rpx 24rpx;
}

.activity-title {
  display: block;
  font-size: 34rpx;
  font-weight: 600;
  color: var(--ink);
}

.activity-summary {
  display: block;
  margin-top: 12rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.6;
}

.activity-meta {
  display: flex;
  align-items: flex-start;
  margin-top: 16rpx;
}

.activity-meta .icon {
  margin-top: 4rpx;
  margin-right: 12rpx;
}

.meta-text {
  flex: 1;
  font-size: 26rpx;
  color: var(--ink-2);
}

.quota {
  margin-top: 24rpx;
}

.quota-head {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.quota-text {
  font-size: 26rpx;
  color: var(--brand);
  font-weight: 600;
}

.quota-count {
  font-size: 22rpx;
  color: var(--ink-3);
}

.quota-track {
  margin-top: 12rpx;
  height: 10rpx;
  border-radius: 6rpx;
  background: #edf0f6;
  overflow: hidden;
}

.quota-fill {
  height: 100%;
  border-radius: 6rpx;
  background: linear-gradient(90deg, #2f6bff, #62a0ff);
}

.activity-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 22rpx;
  border-top: 2rpx solid var(--line);
}

.activity-price {
  font-size: 26rpx;
  color: var(--ink);
  font-weight: 500;
}

.activity-go {
  display: flex;
  align-items: center;
}

.activity-go-text {
  font-size: 26rpx;
  color: var(--brand);
  margin-right: 6rpx;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  opacity: 0.35;
}

.error-retry {
  display: inline-flex;
  padding: 0 48rpx;
  height: 80rpx;
}
