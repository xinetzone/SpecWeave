.signup-page {
  /* 底部固定提交栏高度 ≈ 18+88+18 rpx，再加安全区，用 calc 精确对齐 */
  padding: 24rpx 24rpx calc(150rpx + env(safe-area-inset-bottom));
}

.summary {
  display: flex;
  padding: 24rpx;
}

.summary-cover {
  width: 168rpx;
  height: 168rpx;
  flex: none;
  border-radius: 16rpx;
  background: #dfe4ee;
}

.summary-info {
  flex: 1;
  min-width: 0;
  margin-left: 24rpx;
}

.summary-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: var(--ink);
  line-height: 1.4;
}

.summary-meta {
  display: flex;
  align-items: flex-start;
  margin-top: 12rpx;
}

.summary-meta .icon {
  margin-top: 3rpx;
  margin-right: 10rpx;
}

.summary-text {
  flex: 1;
  font-size: 24rpx;
  color: var(--ink-2);
}

.signin-desc {
  display: block;
  margin-top: 16rpx;
  font-size: 26rpx;
  color: var(--ink-2);
  line-height: 1.6;
}

.signin-btn {
  margin-top: 26rpx;
}

.field {
  position: relative;
  margin-top: 28rpx;
}

.field-label {
  display: block;
  font-size: 26rpx;
  color: var(--ink-2);
  margin-bottom: 14rpx;
}

.field-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #f5f7fb;
  border: 2rpx solid transparent;
  font-size: 28rpx;
  color: var(--ink);
}

.field-input-error {
  border-color: #f0a3a3;
  background: #fff6f6;
}

.field-placeholder {
  color: var(--ink-3);
}

.field-textarea {
  width: 100%;
  height: 160rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #f5f7fb;
  font-size: 27rpx;
  color: var(--ink);
  line-height: 1.6;
}

.field-count {
  display: block;
  margin-top: 10rpx;
  text-align: right;
  font-size: 22rpx;
  color: var(--ink-3);
}

.field-error {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #e05a5a;
}

.stepper {
  display: flex;
  align-items: center;
}

.stepper-btn {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #f0f3f9;
  display: flex;
  align-items: center;
  justify-content: center;
}

.stepper-value {
  min-width: 96rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--ink);
}

.upload-desc {
  display: block;
  margin-top: 14rpx;
  font-size: 25rpx;
  color: var(--ink-3);
  line-height: 1.6;
}

.upload-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 22rpx;
}

.upload-box {
  width: 176rpx;
  height: 176rpx;
  margin-right: 20rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #f5f7fb;
}

.upload-preview {
  width: 100%;
  height: 100%;
  display: block;
}

.upload-box-action {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx dashed #d3d9e5;
  background: #fafbfd;
}

.upload-text {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: var(--ink-3);
}

.footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  padding: 18rpx 28rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--surface);
  box-shadow: 0 -4rpx 20rpx rgba(31, 39, 51, 0.06);
}

.footer-info {
  flex: 1;
  min-width: 0;
}

.footer-quota {
  display: block;
  font-size: 24rpx;
  color: var(--brand);
  font-weight: 600;
}

.footer-hint {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  color: var(--ink-3);
}

.footer-btn {
  flex: none;
  width: 280rpx;
  height: 88rpx;
  border-radius: 44rpx;
}

.error-retry {
  display: inline-flex;
  padding: 0 48rpx;
  height: 80rpx;
}
