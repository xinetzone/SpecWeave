<view class="page mine-page">
  <!-- 未登录：引导授权 -->
  <view class="card signin-card" wx:if="{{!signedIn}}">
    <image class="signin-icon" src="/assets/icons/ic-pencil.png" mode="aspectFit" />
    <text class="signin-title">授权登录查看我发起的活动</text>
    <text class="signin-desc">你发起的内容保存在云端数据库，仅本人可管理与编辑。</text>
    <button class="btn-primary signin-btn" bindtap="onTapSignIn" disabled="{{signingIn}}">
      <text>{{signingIn ? '授权中…' : '微信授权登录'}}</text>
    </button>
  </view>

  <block wx:else>
    <view class="loading" wx:if="{{loading}}">正在加载我的活动…</view>

    <view class="error-box" wx:if="{{!loading && errorText}}">
      <text class="error-text">{{errorText}}</text>
      <button class="btn-ghost error-retry" bindtap="loadActivities">重新加载</button>
    </view>

    <view class="list" wx:if="{{!loading && !errorText}}">
      <view class="mine-item card" wx:for="{{activities}}" wx:key="id">
        <view class="mine-head">
          <image class="mine-cover" src="{{item.cover}}" mode="aspectFill" />
          <view class="mine-head-info">
            <text class="mine-title">{{item.title}}</text>
            <text class="mine-time">{{item.startsAt}}</text>
          </view>
          <text class="mine-status mine-status-{{item.statusClass}}">{{item.status}}</text>
        </view>

        <view class="mine-body">
          <view class="mine-row">
            <image class="icon icon-sm icon-muted" src="/assets/icons/ic-location.png" mode="aspectFit" />
            <text class="mine-text">{{item.location}}</text>
          </view>
          <view class="mine-row">
            <image class="icon icon-sm icon-muted" src="/assets/icons/ic-users.png" mode="aspectFit" />
            <text class="mine-text">{{item.signedUp}} 人已报名 · {{item.quotaText}}</text>
          </view>
          <view class="mine-row" wx:if="{{item.priceNote}}">
            <image class="icon icon-sm icon-muted" src="/assets/icons/ic-ticket.png" mode="aspectFit" />
            <text class="mine-text">{{item.priceNote}}</text>
          </view>
        </view>

        <view class="mine-foot">
          <button class="btn-text" bindtap="onTapEdit" data-id="{{item.id}}">编辑</button>
          <button
            class="btn-text {{item.published ? 'mine-btn-danger' : ''}}"
            bindtap="onTapToggle"
            data-id="{{item.id}}"
            disabled="{{operatingId === item.id || item.status === '已结束'}}"
          >
            <text>{{operatingId === item.id ? '处理中…' : (item.published ? '下架' : '重新上架')}}</text>
          </button>
        </view>
      </view>

      <view class="empty" wx:if="{{!activities.length}}">
        <image class="empty-icon" src="/assets/icons/ic-pencil.png" mode="aspectFit" />
        <text class="empty-title">你还没有发起过活动</text>
        <text class="empty-desc">挑一个模板，把想做的事组织起来</text>
        <button class="btn-primary empty-btn" bindtap="onTapGoPublish">去发起活动</button>
      </view>
    </view>
  </block>
</view>
