<view class="page detail-page">
  <view class="loading" wx:if="{{loading}}">正在加载活动详情…</view>

  <view class="error-box" wx:if="{{!loading && errorText}}">
    <text class="error-text">{{errorText}}</text>
    <button class="btn-ghost error-retry" bindtap="loadDetail">重新加载</button>
  </view>

  <block wx:if="{{!loading && detail}}">
    <view class="cover-wrap">
      <image class="cover" src="{{detail.cover}}" mode="aspectFill" binderror="onCoverError" />
      <view class="cover-badge" wx:if="{{detail.countdown}}">{{detail.countdown}}</view>
    </view>

    <view class="detail-body">
      <!-- 标题与费用 -->
      <view class="card">
        <text class="detail-title">{{detail.title}}</text>
        <text class="detail-summary">{{detail.summary}}</text>

        <view class="price-row">
          <text class="price-main">{{detail.priceNote}}</text>
          <text class="price-quota">{{detail.quotaText}}</text>
        </view>

        <view class="quota">
          <view class="quota-track">
            <view class="quota-fill" style="width: {{detail.percent}}%"></view>
          </view>
          <text class="quota-count">{{detail.signedUp}}/{{detail.capacity}} 人已报名</text>
        </view>
      </view>

      <!-- 时间地点 -->
      <view class="card">
        <text class="section-title">时间与地点</text>
        <view class="info-row">
          <image class="icon icon-sm icon-muted" src="/assets/icons/ic-calendar.png" mode="aspectFit" />
          <text class="info-text">{{detail.startsAt}}<text wx:if="{{detail.endsAt}}"> 至 {{detail.endsAt}}</text></text>
        </view>
        <view class="info-row">
          <image class="icon icon-sm icon-muted" src="/assets/icons/ic-location.png" mode="aspectFit" />
          <text class="info-text">{{detail.location}}</text>
        </view>
        <view class="info-row">
          <image class="icon icon-sm icon-muted" src="/assets/icons/ic-users.png" mode="aspectFit" />
          <text class="info-text">{{detail.capacity}} 人成行 · 目前 {{detail.signedUp}} 人</text>
        </view>
      </view>

      <!-- 活动亮点 -->
      <view class="card" wx:if="{{detail.highlights.length}}">
        <text class="section-title">活动亮点</text>
        <view class="highlight" wx:for="{{detail.highlights}}" wx:key="*this">
          <image class="icon icon-sm check-icon" src="/assets/icons/ic-check.png" mode="aspectFit" />
          <text class="highlight-text">{{item}}</text>
        </view>
      </view>

      <!-- 报名须知 -->
      <view class="card" wx:if="{{detail.notes.length}}">
        <text class="section-title">报名须知</text>
        <view class="note" wx:for="{{detail.notes}}" wx:key="*this">
          <text class="note-index">{{index + 1}}</text>
          <text class="note-text">{{item}}</text>
        </view>
      </view>

      <!-- 报名入口 -->
      <view class="card" wx:if="{{!signedIn}}">
        <text class="section-title">报名前请先授权登录</text>
        <text class="signin-desc">授权后即可提交报名信息，并在「我的报名」中随时查看与取消。</text>
        <button class="btn-primary signin-btn" bindtap="onTapSignIn">
          <image class="icon icon-sm btn-icon" src="/assets/icons/ic-users.png" mode="aspectFit" />
          <text>微信授权登录</text>
        </button>
      </view>
    </view>

    <!-- 底部固定操作栏 -->
    <view class="footer">
      <view class="footer-info">
        <text class="footer-quota">{{detail.quotaText}}</text>
        <text class="footer-price">{{detail.priceNote}}</text>
      </view>
      <button class="btn-primary footer-btn" bindtap="onTapSignup" disabled="{{detail.full}}">
        <text>{{detail.full ? '名额已满' : '立即报名'}}</text>
      </button>
    </view>
  </block>
</view>
