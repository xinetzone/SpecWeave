# =============================================================================
# devcontainer-base — IDE 桥接模式环境变量模板
# =============================================================================
# 使用方式：cp .env.ide.example .env
# 配合 docker-compose.ide.yml 使用：
#   docker compose -f docker-compose.ide.yml up -d
#
# 本配置基于「容器开发服务宿主桥接模式」五要素：
#   1. 服务绑定0.0.0.0（镜像内已配置）
#   2. 端口映射（SSH + Jupyter）
#   3. 认证配置（Token/密码）
#   4. CORS跨域（IDE WebView必需）
#   5. 文件卷挂载（./workspace ↔ /workspace）
# =============================================================================

# ─── 凭据配置 ──────────────────────────────────────────────────────────────
# SSH密码（用于 ssh -p 2222 devuser@localhost）
USER_PASSWORD=devpass

# Jupyter Token（IDE连接URL中使用，建议修改为强密码）
# VSCode/Trae 连接URL: http://localhost:8888/?token=<JUPYTER_TOKEN>
JUPYTER_TOKEN=devtoken123

# ─── CORS 配置（要素4：IDE WebView必需）────────────────────────────────────
# 允许跨域访问的Origin，"*"允许所有来源（开发环境推荐）
# 更安全的选项：
#   JUPYTER_ALLOW_ORIGIN="vscode-webview://*"  # 仅允许VSCode WebView
#   JUPYTER_ALLOW_ORIGIN="http://localhost:*"   # 仅允许localhost
JUPYTER_ALLOW_ORIGIN=*

# ─── 权限配置 ──────────────────────────────────────────────────────────────
GRANT_SUDO=yes
ALLOW_ROOT_SSH=no

# ─── 端口配置 ──────────────────────────────────────────────────────────────
# DinD模式默认端口（docker compose -f docker-compose.ide.yml up -d）
SSH_PORT=2222
JUPYTER_PORT=8888

# DooD模式默认端口（docker compose -f docker-compose.ide.yml --profile dood up -d）
SSH_PORT_DOOD=2223
JUPYTER_PORT_DOOD=8889

# ─── 服务开关 ──────────────────────────────────────────────────────────────
ENABLE_SSH=yes
ENABLE_DOCKER=yes
ENABLE_JUPYTER=yes
ENABLE_PODMAN=no

# ─── 时区与语言 ────────────────────────────────────────────────────────────
TZ=Asia/Shanghai
LANG=zh_CN.UTF-8

# ─── 调试 ──────────────────────────────────────────────────────────────────
DEBUG=0
