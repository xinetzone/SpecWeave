# =============================================================================
# devcontainer-base 环境变量配置模板
# =============================================================================
# 使用方式：cp .env.example .env，然后按需修改
# .env 文件会被 scripts/start.sh 和 docker compose 自动加载
# =============================================================================

# ─── 运行模式 ──────────────────────────────────────────────────────────────
# PROFILE: dind (Docker-in-Docker, 隔离模式, 需--privileged) | dood (Docker-out-of-Docker, 共享宿主机) | ssh-only (仅SSH) | llvm (LLVM变体: conda main + LLVM/Clang + free-threading Python 3.14t)
PROFILE=dind

# ─── 国内镜像源（构建时使用）────────────────────────────────────────────────
# 取消下面两行注释即可使用国内阿里云镜像（等价于 build.sh --cn）
# APT_MIRROR=aliyun
# PIP_MIRROR=aliyun
# 可选值: official(默认) | aliyun(阿里云) | tuna(清华TUNA)
APT_MIRROR=official
PIP_MIRROR=official
# conda 镜像源（llvm 变体构建用；注意 aliyun 的 conda-forge 镜像已下线(404)）
# 可选值: official(默认) | tuna(清华TUNA) | bfsu(北外) | aliyun(已失效)
CONDA_MIRROR=official
# LLVM 工具链版本（llvm 变体构建用，需与 conda-forge 可用版本一致）
LLVM_VERSION=22.1.8

# ─── 凭据配置 ──────────────────────────────────────────────────────────────
# SSH密码（留空则start.sh自动生成随机12位密码）
USER_PASSWORD=changeme

# Jupyter Token（留空则start.sh自动生成随机24位token）
# ssh-only模式下此变量无效
JUPYTER_TOKEN=devcontainer123

# Jupyter CORS 允许的Origin（IDE桥接模式必需）
# 设置为"*"允许所有来源（VSCode/Trae IDE WebView需要）
# 安全环境可指定具体Origin如 "vscode-webview://*"
JUPYTER_ALLOW_ORIGIN=*

# ─── 权限配置 ──────────────────────────────────────────────────────────────
# 是否授予devuser免密sudo权限: yes | no
GRANT_SUDO=yes

# 是否允许root通过SSH登录: yes | no（默认禁用root SSH）
ALLOW_ROOT_SSH=no

# ─── 端口配置 ──────────────────────────────────────────────────────────────
# SSH端口映射（默认按profile不同：dind=2222, dood=2223, ssh-only=2224）
# SSH_PORT=2222

# Jupyter端口映射（dind=8888, dood=8889, ssh-only无）
# JUPYTER_PORT=8888

# ─── 服务开关 ──────────────────────────────────────────────────────────────
ENABLE_SSH=yes
ENABLE_DOCKER=yes
ENABLE_PODMAN=no
ENABLE_JUPYTER=yes

# ─── 时区与语言 ────────────────────────────────────────────────────────────
TZ=Asia/Shanghai
LANG=zh_CN.UTF-8

# ─── 调试 ──────────────────────────────────────────────────────────────────
DEBUG=0
