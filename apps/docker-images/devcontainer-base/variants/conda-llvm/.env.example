# =============================================================================
# devcontainer-base Conda-LLVM Variant - 环境变量/构建参数配置模板
# =============================================================================
# 使用方式：在 variants/conda-llvm/ 目录下 cp .env.example .env，然后按需修改
# 构建脚本 variants/build.sh 会自动加载此文件
# =============================================================================

# ─── 基础镜像标签 ──────────────────────────────────────────────────────────
# 基础镜像 devcontainer-base 的标签（本变体直接基于基础镜像，无中间变体），默认 latest
BASE_TAG=latest

# ─── 镜像源配置（构建时使用；基础镜像 V2 已内置默认源，变体按需重写）──────────
# APT 源: official(默认, Ubuntu官方) | aliyun(阿里云) | tuna(清华TUNA)
APT_MIRROR=official

# Conda 源: bfsu(默认, 北外镜像) | tuna(清华TUNA) | aliyun(阿里云) | official(conda-forge官方)
CONDA_MIRROR=bfsu

# PyPI pip 源: aliyun(默认, 阿里云) | tuna(清华TUNA) | official(PyPI官方)
PIP_MIRROR=aliyun

# ─── LLVM 工具链配置 ──────────────────────────────────────────────────────
# LLVM 版本（llvmdev, clangdev, clang, lld 统一版本；lldb 已排除——conda-forge
# 无 cp314t 构建，安装会引发 python GIL 回归，见 README 注意事项）
LLVM_VERSION=22.1.8
