# torch-dev 变体环境变量
# 复制为 .env 后可覆盖默认值（build.sh --build-arg 优先于 .env）

# 基础镜像标签
BASE_TAG=latest

# 镜像源选择
APT_MIRROR=official
CONDA_MIRROR=official
PIP_MIRROR=official

# PyTorch CUDA 索引版本
# 可选值: cu130 (CUDA 13.0, 默认), cu128 (CUDA 12.8), cpu (CPU only)
TORCH_CUDA_INDEX=cu130

# PyTorch 版本（可选，固定版本时取消注释；默认安装最新兼容版）
# TORCH_VERSION=2.13.0
# TORCHVISION_VERSION=0.28.0
