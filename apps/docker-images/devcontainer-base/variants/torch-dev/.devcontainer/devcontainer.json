{
  "name": "Torch Dev (torch-dev) - PyTorch CUDA free-threading",
  "image": "devcontainer-base:torch-dev-latest",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "remoteUser": "devuser",

  "forwardPorts": [22, 8888],
  "portsAttributes": {
    "22": { "label": "SSH", "onAutoForward": "silent" },
    "8888": { "label": "JupyterLab", "onAutoForward": "openBrowser" }
  },

  "containerEnv": {
    "USER_PASSWORD": "dev",
    "JUPYTER_TOKEN": "dev",
    "TZ": "Asia/Shanghai",
    "GRANT_SUDO": "yes",
    "WORKSPACE_CHOWN_MODE": "named-only",
    "PYTHON_GIL": "0",
    "OMP_NUM_THREADS": "4",
    "OPENBLAS_NUM_THREADS": "1",
    "KMP_DUPLICATE_LIB_OK": "TRUE",
    "NVIDIA_VISIBLE_DEVICES": "all",
    "NVIDIA_DRIVER_CAPABILITIES": "compute,utility"
  },

  "runArgs": [
    "--gpus", "all",
    "--privileged",
    "--security-opt", "seccomp=unconfined",
    "--cap-add=SYS_PTRACE",
    "--ipc=host",
    "--ulimit", "memlock=-1",
    "--ulimit", "stack=67108864",
    "--shm-size=16g"
  ],

  "mounts": [
    "source=devcontainer-pip-cache,target=/root/.cache/pip,type=volume",
    "source=devcontainer-conda-pkgs,target=/opt/conda/pkgs,type=volume",
    "source=docker-data-vol,target=/var/lib/docker,type=volume"
  ],

  "hostRequirements": {
    "cpus": 8,
    "memory": "16gb",
    "storage": "64gb",
    "gpu": true
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-toolsai.jupyter",
        "ms-toolsai.jupyter-keymap",
        "ms-toolsai.jupyter-renderers",
        "redhat.vscode-yaml",
        "streetsidesoftware.code-spell-checker",
        "ms-azuretools.vscode-docker",
        "editorconfig.editorconfig",
        "llvm-vs-code-extensions.vscode-clangd",
        "ms-vscode.cmake-tools"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/envs/main/bin/python",
        "python.terminal.activateEnvironment": false,
        "python.analysis.typeCheckingMode": "basic",
        "python.analysis.autoImportCompletions": true,
        "jupyter.jupyterServerType": "local",
        "jupyter.askForKernelRestart": false,
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": { "path": "/bin/bash", "args": ["-l"] }
        },
        "files.eol": "\n",
        "editor.formatOnSave": true,
        "files.trimTrailingWhitespace": true,
        "[python]": {
          "editor.tabSize": 4,
          "editor.insertSpaces": true,
          "editor.formatOnSave": true,
          "editor.codeActionsOnSave": {
            "source.organizeImports": "explicit"
          }
        }
      }
    }
  },

  "postCreateCommand": "/opt/conda/envs/main/bin/python -c \"import torch,torchvision;print(f'✅ torch-dev ready: torch {torch.__version__}, torchvision {torchvision.__version__}, CUDA={torch.cuda.is_available()}, devices={torch.cuda.device_count()}, GIL disabled')\"",

  "postStartCommand": "/opt/conda/envs/main/bin/python -c \"import torch; print(f'GPU: {torch.cuda.get_device_name(0) if torch.cuda.is_available() else \\\"None\\\"}'); print('SSH: ssh devuser@localhost -p <port> (password: dev) | JupyterLab: http://localhost:8888?token=dev')\"",

  "shutdownAction": "stopContainer"
}
