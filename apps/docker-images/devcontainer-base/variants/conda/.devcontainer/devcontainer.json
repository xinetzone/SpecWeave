{
  "name": "Conda Base (conda)",
  "image": "devcontainer-base:conda-latest",
  "workspaceFolder": "/workspace",
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind,consistency=cached",
  "remoteUser": "devuser",

  "forwardPorts": [22, 8888],
  "portsAttributes": {
    "22": { "label": "SSH", "onAutoForward": "silent" },
    "8888": { "label": "JupyterLab", "onAutoForward": "openBrowser" }
  },

  "containerEnv": {
    "USER_PASSWORD": "dev",
    "JUPYTER_TOKEN": "dev",
    "TZ": "Asia/Shanghai",
    "GRANT_SUDO": "yes",
    "WORKSPACE_CHOWN_MODE": "named-only"
  },

  "runArgs": [
    "--privileged",
    "--security-opt", "seccomp=unconfined",
    "--shm-size=4g"
  ],

  "mounts": [
    "source=devcontainer-pip-cache,target=/root/.cache/pip,type=volume",
    "source=devcontainer-conda-pkgs,target=/opt/conda/pkgs,type=volume",
    "source=docker-data-vol,target=/var/lib/docker,type=volume"
  ],

  "hostRequirements": {
    "cpus": 2,
    "memory": "4gb",
    "storage": "20gb"
  },

  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "ms-python.debugpy",
        "ms-toolsai.jupyter",
        "redhat.vscode-yaml",
        "ms-azuretools.vscode-docker",
        "editorconfig.editorconfig"
      ],
      "settings": {
        "python.defaultInterpreterPath": "/opt/conda/bin/python",
        "python.terminal.activateEnvironment": false,
        "python.analysis.typeCheckingMode": "basic",
        "jupyter.jupyterServerType": "local",
        "terminal.integrated.defaultProfile.linux": "bash",
        "terminal.integrated.profiles.linux": {
          "bash": { "path": "/bin/bash", "args": ["-l"] }
        },
        "files.eol": "\n",
        "editor.formatOnSave": true,
        "[python]": {
          "editor.tabSize": 4,
          "editor.insertSpaces": true
        }
      }
    }
  },

  "postCreateCommand": "conda --version && python --version && echo '✅ conda base environment ready'",

  "postStartCommand": "echo 'Container ready | SSH: devuser@localhost:<port> (pw=dev) | JupyterLab: http://localhost:8888?token=dev'",

  "shutdownAction": "stopContainer"
}
