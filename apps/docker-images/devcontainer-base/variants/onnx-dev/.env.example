# =============================================================================
# devcontainer-base ONNX-Dev Variant - 环境变量/构建参数配置模板
# =============================================================================
# 使用方式：在 variants/onnx-dev/ 目录下 cp .env.example .env，然后按需修改
# 构建脚本 variants/build.sh 会自动加载此文件
# =============================================================================

# ─── 基础镜像标签 ──────────────────────────────────────────────────────────
# 基础镜像 devcontainer-base:conda-llvm-* 的标签，默认 latest
# 依赖链：devcontainer-base:latest -> devcontainer-base:conda-llvm-* -> devcontainer-base:onnx-dev-*
# 注意：conda 中间变体已下线，conda-llvm 直接基于基础镜像
BASE_TAG=latest

# ─── 镜像源配置（构建时使用，继承自 conda-llvm 变体）──────────────────────
# APT 源: official(默认, Ubuntu官方) | aliyun(阿里云) | tuna(清华TUNA)
APT_MIRROR=official

# Conda 源: bfsu(默认, 北外镜像) | tuna(清华TUNA) | aliyun(阿里云) | official(conda-forge官方)
CONDA_MIRROR=bfsu

# PyPI pip 源: aliyun(默认, 阿里云) | tuna(清华TUNA) | official(PyPI官方)
# ONNX 生态（onnx/onnxruntime/onnx-simplifier/onnxscript；onnxoptimizer 因
# free-threading 不兼容被排除）全部经 pip 安装至 conda main 环境，使用本配置
PIP_MIRROR=aliyun

# ─── PyTorch 说明 ─────────────────────────────────────────────────────────
# 本变体【不含 PyTorch】（torch/torchvision 显式排除并有构建期负向验证防线）。
# 如需 PyTorch，运行期按需安装（不进镜像）：
#   pip install torch torchvision --index-url https://download.pytorch.org/whl/cpu
# 或使用 onnx-pytorch 变体。
