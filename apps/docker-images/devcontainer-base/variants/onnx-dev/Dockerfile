# syntax=docker/dockerfile:1.7-labs
# =============================================================================
# DevContainer Base - ONNX-Dev (pure ONNX, no PyTorch)
# Base: devcontainer-base:conda-llvm-${BASE_TAG}
# Excluded: torch/torchvision (by design); onnxoptimizer (Py_LIMITED_API x Py_GIL_DISABLED, CPython #111506)
# Build (CN): docker build -f variants/onnx-dev/Dockerfile --build-arg APT_MIRROR=aliyun --build-arg PIP_MIRROR=aliyun -t devcontainer-base:onnx-dev-latest .
# Verify: docker run --rm devcontainer-base:onnx-dev-latest /opt/conda/envs/main/bin/python -c "import onnx,onnxruntime;print(onnx.__version__,onnxruntime.__version__)"
# =============================================================================

ARG BASE_TAG=latest
ARG APT_MIRROR=official
ARG CONDA_MIRROR=bfsu
ARG PIP_MIRROR=aliyun

FROM devcontainer-base:conda-llvm-${BASE_TAG}

ARG BASE_TAG
ARG APT_MIRROR
ARG CONDA_MIRROR
ARG PIP_MIRROR

LABEL maintainer="SpecWeave"
LABEL description="DevContainer onnx-dev: pure ONNX ecosystem (no PyTorch) in conda main env (Python 3.14t ft)"
LABEL variant="onnx-dev"
LABEL torch.variant="absent"

ENV CONDA_DIR=/opt/conda \
    CONDA_DEFAULT_ENV=main
ENV PATH=/opt/conda/envs/main/bin:/opt/conda/bin:${PATH}

SHELL ["/bin/bash", "-e", "-o", "pipefail", "-c"]

# Framework already in base layer at /usr/local/share/variant-framework/

# ── Stage 1/3: Init + base verification ────────────────────────────
RUN <<'S1'
source /usr/local/share/variant-framework/variant-framework.sh
variant_timer_start "onnx-dev"
variant_timer_stage 1 "Init + base verification"
test -d /opt/conda/envs/main && variant_log_ok "main env exists"
llvm-config --version 2>&1 | head -1
clang --version 2>&1 | head -1
S1

# ── Stage 2/3: ONNX ecosystem install + guards ────────────────────
RUN --mount=type=cache,target=/root/.cache/pip,sharing=locked \
    <<'S2'
source /usr/local/share/variant-framework/variant-framework.sh
variant_timer_stage 2 "ONNX ecosystem install + guards"
variant_activate_main_env

pip_install_group "G1: ONNX Core" \
    "onnx (model format) + onnxruntime (CPU inference engine)" \
    onnx onnxruntime

# NOTE: onnxoptimizer EXCLUDED — no cp314t wheel, sdist py_limited_api='cp312'
# incompatible with Py_GIL_DISABLED (CPython #111506); onnxsim 0.5+ covers its use cases.
pip_install_group "G2: ONNX Tools" \
    "onnx-simplifier + onnxscript (onnxoptimizer excluded: ft-incompatible)" \
    onnx-simplifier onnxscript

assert_python_cp314t
assert_free_threading
assert_package_absent torch
assert_package_absent torchvision

cleanup_pycache
cleanup_conda_pip_cache
S2

# ── Stage 3/3: Init script + build-info + verification + smoke ────
RUN <<'S3'
set +o pipefail
source /usr/local/share/variant-framework/variant-framework.sh
variant_timer_stage 3 "Init + build-info + verification + smoke"
variant_activate_main_env

cat > /etc/profile.d/onnx-dev-init.sh <<'INIT'
#!/bin/bash
[ -f "/opt/conda/etc/profile.d/conda.sh" ] && source "/opt/conda/etc/profile.d/conda.sh" && conda activate main 2>/dev/null || true
[[ ":$PATH:" != *":/opt/conda/envs/main/bin:"* ]] && export PATH="/opt/conda/envs/main/bin:$PATH"
INIT
chmod +x /etc/profile.d/onnx-dev-init.sh

[ -f /home/devuser/.bash_profile ] || echo "# Auto-generated by onnx-dev build" > /home/devuser/.bash_profile
grep -q "source /etc/profile.d/onnx-dev-init.sh" /home/devuser/.bash_profile 2>/dev/null \
    || echo "source /etc/profile.d/onnx-dev-init.sh" >> /home/devuser/.bash_profile
chown devuser:devuser /home/devuser/.bash_profile /home/devuser/.bashrc 2>/dev/null || true

ensure_all_permissions

variant_write_build_info "onnx-dev" "conda-llvm-${BASE_TAG}" \
    "VARIANT_DESCRIPTION=Pure ONNX ecosystem (no PyTorch) in conda main env (Python 3.14t ft)" \
    "ONNX_VERSION_ACTUAL=$(python -c 'import onnx;print(onnx.__version__)')" \
    "ONNXRUNTIME_VERSION_ACTUAL=$(python -c 'import onnxruntime;print(onnxruntime.__version__)')" \
    "PACKAGES_INSTALLED=onnx,onnxruntime,onnx-simplifier,onnxscript" \
    "PACKAGES_EXCLUDED=torch,torchvision(by design);onnxoptimizer(ft-incompatible:CPython#111506)" \
    "ACTIVATION_SCRIPT=/etc/profile.d/onnx-dev-init.sh" \
    "BASE_VARIANT=conda-llvm(LLVM toolchain inherited)"

cleanup_all

verify_validation_header "ONNX + LLVM Inheritance Verification"
verify_bash_syntax /etc/profile.d/onnx-dev-init.sh
assert_package_present onnx
assert_package_present onnxruntime
assert_package_present onnxsim "onnx-simplifier"
assert_package_present onnxscript
assert_python_cp314t
assert_free_threading
assert_package_absent torch
assert_package_absent torchvision
llvm-config --version 2>&1 | head -1 && echo "  [OK] LLVM toolchain inherited"
clang --version 2>&1 | head -1
verify_base_services
echo -n "  [VERIFY] devuser ONNX access... "
su - devuser -c "python -c 'import onnx,onnxruntime;print(onnx.__version__,onnxruntime.__version__)'" >/dev/null 2>&1 \
    && echo "[OK]" || { echo "[FAIL]"; exit 1; }

python - <<'PYSMOKE'
import sys, numpy as np, onnx
from onnx import helper, TensorProto
import onnxruntime as ort
assert sys._is_gil_enabled() is False, "GIL must remain disabled"
a = helper.make_tensor_value_info("a", TensorProto.FLOAT, [2])
b = helper.make_tensor_value_info("b", TensorProto.FLOAT, [2])
c = helper.make_tensor_value_info("c", TensorProto.FLOAT, [2])
graph = helper.make_graph([helper.make_node("Add", ["a","b"], ["c"])], "add_graph", [a,b], [c])
model = helper.make_model(graph, opset_imports=[helper.make_opsetid("", 13)])
onnx.checker.check_model(model)
sess = ort.InferenceSession(model.SerializeToString(), providers=["CPUExecutionProvider"])
out = sess.run(None, {"a": np.array([1.0,2.0], dtype=np.float32), "b": np.array([3.0,4.0], dtype=np.float32)})[0]
assert np.allclose(out, [4.0,6.0]), f"inference mismatch: {out}"
print(f"[OK] Pure-ONNX smoke test passed: {out.tolist()}")
PYSMOKE

variant_timer_summary "onnx-dev Variant (add-on)"
echo "########################################################################"
echo "# ONNX-DEV BUILD COMPLETE - Pure ONNX ecosystem, torch-free, GIL off"
echo "########################################################################"
S3
