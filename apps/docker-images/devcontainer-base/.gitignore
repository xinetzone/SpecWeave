# Build caches and logs
.cache/
logs/
local-cache/

# Python cache (prevents __pycache__/*.pyc bloat in repo and Docker context)
__pycache__/
*.pyc
*.pyo
*.pyd

# Runtime directories
workspace/
local-results*/
benchmark_results*.json

# Build/verification/benchmark reports (directory structure preserved)
reports/
*.html
*report*.json
benchmark-results.json
benchmark-results-docker/
verification-report*.json
!reports/.gitkeep
!reports/README.md

# Local environment (contains credentials)
.env

# Local build helper scripts (WSL-specific, contain hardcoded paths)
_*.sh

# Docker volumes (metadata)
*.log

# OS files
.DS_Store
Thumbs.db

# Editor
.vscode/
.idea/
*.swp

# ONNX models
*.onnx

# >>> security-secrets (auto-managed by scripts/secure-gitignore.sh) >>>
# ─── Environment files (contain passwords, tokens, keys) ───
.env
.env.dev
.env.local
.env.*.local
.env.*.bak
.env.*.old
.env.prod
.env.staging
.env.production
.env.development.local

# ─── SSH private keys & credentials ───
*.pem
*.key
id_rsa
id_rsa.*
id_ed25519
id_ed25519.*
id_ecdsa
id_ecdsa.*
*.sec
credentials
*.credentials

# ─── Docker/container secrets ───
docker-compose.override.yml
docker-compose.*.local.yml

# ─── White-list: safe files that SHOULD be tracked ───
!*.pub
!*.pem.example
!*.key.example
!.env.example
!.env.dev.example
!.env.ide.example
# <<< security-secrets (auto-managed) <<<
