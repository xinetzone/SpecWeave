# =============================================================================
# devcontainer-base 开发环境配置模板
# =============================================================================
# 使用方式：cp .env.dev.example .env.dev，然后按需修改
# docker compose -f docker-compose.dev.yml --env-file .env.dev up -d
# =============================================================================

# ─── 镜像配置 ─────────────────────────────────────────────────────────────
IMAGE_NAME=devcontainer-base
IMAGE_TAG=test-refactor
CONTAINER_NAME=devcontainer-dev

# ─── 工作目录 ─────────────────────────────────────────────────────────────
# 宿主机代码目录，挂载到容器内 /workspace
# WSL/Linux: ./workspace 或 /home/yourname/projects
# Windows WSL: /mnt/c/Users/yourname/projects 建议使用WSL内路径
WORKSPACE_DIR=./workspace

# ─── 端口配置 ─────────────────────────────────────────────────────────────
# DooD模式（默认）
SSH_PORT=2222
JUPYTER_PORT=8888
# DinD模式（使用 --profile dind 时）
SSH_PORT_DIND=2232
JUPYTER_PORT_DIND=8898

# ─── 凭据配置 ─────────────────────────────────────────────────────────────
# SSH密码（devuser用户，容器内默认非root用户）
USER_PASSWORD=dev123456

# Jupyter Token（访问JupyterLab时使用）
# 浏览器访问: http://localhost:8888/?token=<JUPYTER_TOKEN>
JUPYTER_TOKEN=devcontainer123

# Jupyter CORS（VSCode/Trae IDE WebView需要设为*）
JUPYTER_ALLOW_ORIGIN=*

# SSH公钥（免密登录）- 运行 bash scripts/setup-ssh-key.sh 自动配置
# 也可手动设置为你的公钥内容: ssh-ed25519 AAAAC3NzaC1lZDI1NTE5... you@email.com
SSH_PUBLIC_KEY=

# ─── 权限配置 ─────────────────────────────────────────────────────────────
# 是否授予devuser免密sudo: yes | no
GRANT_SUDO=yes

# 是否允许root通过SSH登录（默认禁用，更安全）: yes | no
ALLOW_ROOT_SSH=no

# UID/GID映射（解决bind mount权限问题，WSL Ubuntu默认1000）
# 运行 `id -u` 在宿主机查看你的UID
LOCAL_USER_ID=1000
LOCAL_GROUP_ID=1000

# chown模式: named-only（推荐，不修改宿主机文件权限）| yes | auto
WORKSPACE_CHOWN_MODE=named-only
JUPYTER_ROOT_CHOWN=named-only

# ─── 宿主机配置文件路径 ──────────────────────────────────────────────────
# Docker配置目录（含registry mirrors等，只读挂载）
DOCKER_CONFIG=~/.docker

# Git全局配置文件（只读挂载，容器内提交代码使用宿主机身份）
GIT_CONFIG=~/.gitconfig

# SSH配置目录（只读挂载，容器内可直接使用宿主机SSH key访问git仓库）
SSH_CONFIG_DIR=~/.ssh

# ─── 服务开关 ─────────────────────────────────────────────────────────────
ENABLE_SSH=yes
ENABLE_JUPYTER=yes
ENABLE_DOCKER=yes
ENABLE_PODMAN=no

# ─── 时区与语言 ────────────────────────────────────────────────────────────
TZ=Asia/Shanghai
LANG=zh_CN.UTF-8

# ─── 调试 ──────────────────────────────────────────────────────────────────
# 设为1可看到entrypoint详细日志
DEBUG=0
