# DevContainer Win11 - Environment Variables Example
# Copy to .env and customize before running

# ── User Configuration ──
# Password for devuser SSH login (default: auto-generated random password)
USER_PASSWORD=devcontainer123

# ── Jupyter Configuration ──
# Jupyter token (default: auto-generated random token)
JUPYTER_TOKEN=mysecret

# Jupyter password (optional, takes precedence over token)
# JUPYTER_PASSWORD=

# Jupyter port (default: 8888)
JUPYTER_PORT=8888

# Jupyter CORS origin (default: *)
# JUPYTER_ALLOW_ORIGIN=

# ── Service Control ──
# Enable SSH (yes/no, default: yes)
ENABLE_SSH=yes

# Enable Jupyter (yes/no, default: yes)
ENABLE_JUPYTER=yes

# ── SSH Keys ──
# SSH public key to inject into authorized_keys
# SSH_PUBLIC_KEY=ssh-ed25519 AAAAC3Nza... user@host

# ── Free-Threading Python ──
# Py_GIL_DISABLED is already set to 1 system-wide in the image
# This is critical for free-threading C extension compilation at runtime
# Py_GIL_DISABLED=1

# ── Build Configuration (for build.ps1 only) ──
# Use China mirrors (tuna for conda, aliyun for pip)
# CN_MIRRORS=true
