# ---- admin-console 环境变量模板 ----
# 复制为 .env 后再填写；.env 已被 .gitignore 覆盖，切勿提交真实密钥。

# 必填：Supabase 项目 URL（Settings → API → Project URL）
SUPABASE_URL=https://your-project.supabase.co

# 必填：Supabase service_role key（服务端专用，绝不下发浏览器）
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 必填：会话签名密钥（建议 openssl rand -hex 32 生成）
# 未配置时会随机生成，导致重启后所有会话失效
SESSION_SECRET=change-me-to-a-long-random-string

# 可选：Storage 桶名（默认 ac-uploads，需与 schema.sql 注释中的桶名一致）
SUPABASE_BUCKET=ac-uploads

# 可选：会话有效期（秒，默认 43200 = 12 小时）
# SESSION_TTL=43200

# 可选：单文件上传上限（字节，默认 5242880 = 5MB；注意 Vercel 请求体上限 4.5MB）
# MAX_UPLOAD_BYTES=5242880

# 可选：seed-admin 建号时使用的默认邮箱/口令；内存降级模式下作为演示账号
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=please-change-me
