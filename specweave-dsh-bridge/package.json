{
  "name": "@specweave/dsh-bridge",
  "version": "0.1.0",
  "private": true,
  "description": "SpecWeave × DeepSeek Harness 桥接插件：把工作区 AGENTS.md + .agents/ 规范容器接入 DSH 会话入口",
  "type": "module",
  "license": "MIT",
  "exports": {
    ".": "./index.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "index.js",
    "lib",
    "skills",
    "locale",
    "cordis.patch.yml",
    "README.md",
    "ACCESS.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "meta": {
    "title": "SpecWeave 工作区入口桥",
    "description": "进入 SpecWeave 工作区时注入启动协议提醒，并提供任务路由、状态查询与提交前校验能力。"
  },
  "scripts": {
    "test": "node --test tests/bridge.test.js"
  }
}
