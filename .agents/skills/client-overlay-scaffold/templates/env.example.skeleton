# __STACK__ 叠加栈 - compose 插值变量模板
#
# 由 client-overlay-scaffold v1.1 骨架生成。替换 __X__ 占位符后使用。
#
# 三处事实源（键集合必须逐一对应，新增/删除键三处同改）：
#   ① compose.yaml 的 ${...} 插值键（本文件）；
#   ② StackSpec.bridge_env_keys：下列「桥接键」区块的键必须与其逐一相同
#      （Windows 透明桥接 WSL 时按此清单透传；通用凭证/镜像源键由
#      utils._BRIDGE_COMMON_ENV_KEYS 内置，不进 bridge_env_keys）；
#   ③ 根 client .env.example 的注释态 <NSU> 段（与本文件同键）。
#
# 两种驱动：
#   ① invoke __NS__.*（推荐）：在 apps/containers/client/.env 写同名键，
#      任务以 load_dotenv(override=False) 注入——shell export > root .env
#      > compose 默认；invoke 会把宿主路径解析为绝对 POSIX 并做存在性校验。
#   ② 裸 podman-compose：在本目录复制为 .env（自动读取）。
#
# Windows 原生 CPython：invoke 自动透明桥接 WSL 发行版（COMPOSE_WSL_DISTRO
#   指定/=none 关闭）；或 invoke env.run-cmd --cmd 'inv __NS__.up'。

# ── 桥接键（StackSpec.bridge_env_keys 与此块逐一对应，勿含凭证/镜像源）──
# 镜像标签 / 容器名（compose project name 固定为 __STACK__）
__NSU___IMAGE_TAG=__IMAGE__
__NSU___CONTAINER_NAME=__STACK__

# 端口映射（与已运行栈错开；client 现有：quant 2222/8888、xmnn 2223/8890、monetize 2224/8892）
__NSU___SSH_PORT=__SSH_PORT__
__NSU___JUPYTER_PORT=__JUPYTER_PORT__

# 通用工作区（绑定容器 /workspace）
__NSU___WORKSPACE=../../workspace

# 【形态 B：源码/数据路径。每个键同时登记三处：① 本文件与根 .env.example；
# ② compose.yaml 长语法 bind 的 ${...}；③ StackSpec.source_mounts 的 env
# 与 bridge_env_keys。invoke 做存在性硬校验；裸 compose 相对路径相对本文件
# 所在 overlays/<stack>/ 目录（apps/ 下通常 ../../../../<dir>）】
# __NSU___SRC_PATH=../../../../apps/<dir>

# ── 非桥接键（基段 rootless-base 与 build args 插值；通用键不进 bridge_env_keys）──
# 凭证（留空 = 基底 entrypoint 自动生成并打印）
USER_PASSWORD=
JUPYTER_TOKEN=
SSH_PUBLIC_KEY=
GRANT_SUDO=yes

# 构建期镜像源（official|aliyun|tuna）。独立 inv __NS__.build 只认命令行
# 参数；此处的值在 inv __NS__.up 的 compose 内联 build 与裸 compose build 生效
PIP_MIRROR=official
# 不需要 conda 源的栈删除下一行（同时删 compose.yaml 对应 build arg，
# StackSpec.conda_mirror 保持 False）
CONDA_MIRROR=official
# 基底镜像（compose build args，通常无需改）
# BASE_IMAGE=localhost/jupyter-podman-rootless:latest
