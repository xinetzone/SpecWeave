# __STACK__ 叠加栈 - compose 插值变量模板
#
# 由 client-overlay-scaffold 骨架生成。替换 __X__ 占位符后使用。
#
# 两处事实源（键集合必须与 compose.yaml 的 ${...} 逐一对应）：
#   ① invoke __NS__.*（推荐）：在 apps/containers/client/.env 写同名键，
#      任务以 load_dotenv(override=False) 注入——shell export > root .env
#      > compose 默认；invoke 会把宿主路径解析为绝对 POSIX 并做存在性校验。
#   ② 裸 podman-compose：在本目录复制为 .env（自动读取）。
#
# Windows 原生 CPython 门禁：WSL2 发行版内运行，或
#   invoke env.run-cmd --cmd 'inv __NS__.up'（自举容器内执行）。

# 镜像标签 / 容器名（compose project name 固定为 __STACK__）
__ENV_PREFIX___IMAGE_TAG=__IMAGE__
__ENV_PREFIX___CONTAINER_NAME=__STACK__

# 端口映射（与已运行栈错开；client 现有：quant 2222/8888、xmnn 2223/8890）
__ENV_PREFIX___SSH_PORT=__SSH_PORT__
__ENV_PREFIX___JUPYTER_PORT=__JUPYTER_PORT__

# 通用工作区（绑定容器 /workspace）
__ENV_PREFIX___WORKSPACE=../../workspace

# 【形态 B：源码/数据路径，invoke 做存在性硬校验；相对路径相对本文件五级到仓库根】
# __ENV_PREFIX___SRC_PATH=../../../../../external/<path>

# 凭证（留空 = 基底 entrypoint 自动生成并打印）
USER_PASSWORD=
JUPYTER_TOKEN=
SSH_PUBLIC_KEY=
GRANT_SUDO=yes

# 构建期镜像源（official|aliyun|tuna）。独立 inv __NS__.build 只认命令行
# 参数；此处的值在 inv __NS__.up 的 compose 内联 build 与裸 compose build 生效
PIP_MIRROR=official
# 不需要 conda 源的栈删除下一行（同时删 compose.yaml 对应 build arg）
CONDA_MIRROR=official
# 基底镜像（compose build args，通常无需改）
# BASE_IMAGE=localhost/jupyter-podman-rootless:latest
