---
# __STACK__ 叠加栈 - Compose Specification（podman-compose / rootless）
#
# 本文件由 client-overlay-scaffold 骨架生成。替换全部 __X__ 占位符后使用：
#   __STACK__ 栈目录名 / __NS__ 命名空间 / __SVC__ 服务名 /
#   __IMAGE__ 镜像标签 / __SSH_PORT__ __JUPYTER_PORT__ 端口 /
#   __CONTAINERFILE__ Containerfile 文件名 / __ENV_PREFIX__ env 前缀
#
# 设计依据（不可变，详见技能 SKILL.md §7）：
#   rootless 三必需：devices /dev/fuse + security_opt label=disable
#   + cgroupns host；严禁 privileged。
#   bind 一律长语法 + create_host_path（G1）。
#   network_mode bridge：machine 无 systemd user bus 时默认项目网络
#   aardvark-dns 失败的规避（G2，新增栈若本机环境已变可复核后调整并注释）。
#
# 两种驱动：① invoke __NS__.*（apps/containers/client 下）；
#           ② 裸 podman-compose（本目录 cp .env.example .env）。

name: __STACK__

services:
  __SVC__:
    container_name: ${__ENV_PREFIX___CONTAINER_NAME:-__STACK__}
    image: ${__ENV_PREFIX___IMAGE_TAG:-__IMAGE__}
    build:
      context: .
      dockerfile: __CONTAINERFILE__
      args:
        BASE_IMAGE: ${BASE_IMAGE:-localhost/jupyter-podman-rootless:latest}
        PIP_MIRROR: ${PIP_MIRROR:-official}
        # 不需要 conda 镜像源的栈删除本行与对应 .env 键
        CONDA_MIRROR: ${CONDA_MIRROR:-official}
    network_mode: bridge
    ports:
      - "${__ENV_PREFIX___SSH_PORT:-__SSH_PORT__}:22"
      - "${__ENV_PREFIX___JUPYTER_PORT:-__JUPYTER_PORT__}:8888"
    volumes:
      # 通用工作区（invoke 路径解析为绝对 POSIX 并自动 mkdir；
      # 裸 compose 的相对路径相对本文件，../../workspace = client/workspace）
      - type: bind
        source: ${__ENV_PREFIX___WORKSPACE:-../../workspace}
        target: /workspace
        bind:
          create_host_path: true
      # 【形态 B 按需复制：源码/数据 bind，每个都用长语法】
      # - type: bind
      #   source: ${__ENV_PREFIX___SRC_PATH:-../../../../../external/<path>}
      #   target: /workspace/<name>
      #   bind:
      #     create_host_path: true
      # 【命名卷示例：构建缓存等（短语法对 named volume 安全）】
      # - __STACK__-cache:/root/.cache/<tool>
    # ── rootless 三必需（与 client ContainerConfig 同源，禁止删改/特权化）──
    devices:
      - /dev/fuse:/dev/fuse
    security_opt:
      - label=disable
    # podman-compose 1.6.0 无 cgroupns 翻译器（空操作），保留声明语义
    cgroupns: host
    environment:
      # 基底 entrypoint 凭证契约（留空串 → 启动时自动生成并打印）
      USER_PASSWORD: "${USER_PASSWORD:-}"
      JUPYTER_TOKEN: "${JUPYTER_TOKEN:-}"
      SSH_PUBLIC_KEY: "${SSH_PUBLIC_KEY:-}"
      GRANT_SUDO: ${GRANT_SUDO:-yes}
      # 【栈业务环境变量在此追加；四凭证全局共用，不要改名】
    labels:
      org.specweave.component: "__SVC__"
      org.specweave.managed-by: "jupyter-podman-client"
    restart: unless-stopped

# 【使用命名卷时在此声明】
# volumes:
#   __STACK__-cache: {}
