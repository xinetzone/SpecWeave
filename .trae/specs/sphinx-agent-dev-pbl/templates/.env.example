# 复制这个文件为 .env，然后把值换成你自己的
#
# ⚠️ 两个关键点：
#   1. .env 文件【绝对不能】提交到 Git（.gitignore 里已经排除了）
#   2. 这个 .env.example 文件【应该】提交，让别人知道要配哪些变量
#
# 用法：
#   cp .env.example .env
#   然后用编辑器打开 .env 填入真实值

# 你的 API 密钥（必填）
LLM_API_KEY=your-api-key-here

# API 服务地址（按老师指定的填）
# OpenAI:    https://api.openai.com/v1
# DeepSeek:  https://api.deepseek.com/v1
# 混元:      以老师提供的地址为准
LLM_BASE_URL=https://api.openai.com/v1

# 使用的模型名（按老师指定的填）
# 例如：gpt-4o-mini / deepseek-chat / hunyuan-lite
LLM_MODEL=gpt-4o-mini
