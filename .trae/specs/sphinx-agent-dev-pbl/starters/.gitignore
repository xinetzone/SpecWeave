# ===================================================================
#  .gitignore（必须放在项目根目录，不是 docs/ 里）
#
#  🔒 学生用法：Task1 步骤 5，直接复制本文件内容到项目根目录的 .gitignore
#
#  ⚠️ .env 那一行是保命的。Task4 起你会把 API Key 写进 .env，
#     如果不排除，密钥会被推到公开的 GitHub 上。
#     这是真实世界里最常出的事故之一。
#
#  验证方法：git status --short
#     如果输出里看到 .env 或 .venv/，立刻停下，回来补这一行。
# ===================================================================

# --- 密钥（最重要，不要删）---
.env

# --- Python 虚拟环境 ---
.venv/
venv/
env/

# --- Python 缓存 ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/

# --- Sphinx 构建产物 ---
_build/
docs/_build/

# --- 编辑器 / 系统 ---
.vscode/
.idea/
.DS_Store
Thumbs.db
