# 复制为 .env（与 compose.yaml 同目录），填入真实值。.env 不要提交到版本库。
# xuan-compose 会自动加载 compose 文件目录下的 .env；也可用 --env-file 多次指定。

# 火山方舟 API Key（compose.yaml 默认走文件 secret：./secrets/ark_key.txt；
# 若改用环境变量注入，请把 generator 的 secrets 段删掉，改为
#   environment:
#     ARK_API_KEY: ${ARK_API_KEY:?需要在 .env 或环境中提供 ARK_API_KEY}
# :? 表示变量缺失或为空时直接报错，拒绝带着空密钥启动）
# ARK_API_KEY=your-ark-api-key

# 端点与模型（默认值已写在 compose.yaml 里，这里仅展示覆盖方式）
# ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# ARK_MODEL=doubao-seedream-5-0-pro-260628

# 3:2 输出尺寸：1K 档 1248x832，2K 档 1872x1248（也可写 "1K"/"2K" 档位）
# OUTPUT_SIZE=1248x832

# 色幕颜色：普通场景绿幕，绿植丰盛场景用品红
# CHROMA_KEY=#00ff00
# CHROMA_KEY=#ff00ff
